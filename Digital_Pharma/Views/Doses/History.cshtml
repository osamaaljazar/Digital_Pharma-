@model List<DoseRecord>
@{ViewData["Title"]="سجل الجرعات";int page=ViewBag.Page;}
<link rel="stylesheet" href="~/css/doctor-workflow.css" />
<main class="workflow"><h1>سجل الجرعات</h1><a asp-action="Index">أدوية اليوم</a>
<p>الجرعة والاسم محفوظان كما كانا عند التسجيل. الأوقات حسب عمّان، ووقت التسجيل لا يُعد وقت التناول الفعلي.</p>
@if(Model.Count==0){<p class="panel">لا توجد تسجيلات في هذه الصفحة.</p>}
@foreach(var record in Model.Take(50)){<section class="panel"><h2>@record.DrugName</h2><p>@record.Day.ToString("yyyy-MM-dd") · @record.Time · @record.DoseAmount.ToString("0.###") @MedicationCardInput.UnitName(record.DoseUnit)</p><strong>@DoseStatus.Label(record.Status)</strong><p>آخر تسجيل: @record.RecordedAt.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd HH:mm")</p><a asp-action="Correct" asp-route-id="@record.Id">تصحيح التسجيل وتاريخ التعديلات</a></section>}
<div class="top">@if(page>1){<a asp-action="History" asp-route-page="@(page-1)">السابق</a>}@if(Model.Count>50){<a asp-action="History" asp-route-page="@(page+1)">التالي</a>}</div>
</main>
