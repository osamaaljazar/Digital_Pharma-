@{ ViewData["Title"]="كلمة مرور جديدة"; Layout=null; var token=(string?)ViewBag.Token; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>كلمة مرور جديدة – Digital Pharma</title><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:20px;background:#0f172a;color:#fff;font-family:Tahoma,Arial,sans-serif}.card{width:min(440px,100%);padding:34px;background:#182338;border:1px solid #334155;border-radius:20px}label{display:block;margin:16px 0 7px}input{width:100%;padding:13px;border:1px solid #52637d;border-radius:10px;background:#243247;color:#fff}button{width:100%;margin-top:20px;padding:13px;border:0;border-radius:11px;background:linear-gradient(135deg,#00a98f,#1268d8);color:#fff;font:inherit;font-weight:700}.error{padding:10px;color:#fecaca;background:#7f1d1d55;border-radius:9px}</style></head><body><main class="card"><h1>تعيين كلمة مرور جديدة</h1>@if(ViewBag.Error!=null){<p class="error">@ViewBag.Error</p>}<form asp-action="ResetPassword" method="post"><input type="hidden" name="token" value="@token"><label for="password">كلمة المرور الجديدة</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required><label for="confirmPassword">تأكيد كلمة المرور</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required><button type="submit">حفظ كلمة المرور الجديدة</button></form></main></body></html>
