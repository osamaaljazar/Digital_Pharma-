@model Digital_Pharma.Models.MultiDrugCheckViewModel
@{
    ViewData["Title"] = "نتيجة الفحص المتعدد";

    var sevColors = new Dictionary<string,string> {
        ["safe"]     = "#00c9a7",
        ["caution"]  = "#3ecf8e",
        ["moderate"] = "#ffa502",
        ["serious"]  = "#ff6348",
        ["critical"] = "#ff4757",
        ["unknown"]  = "#94a3b8"
    };
    var sevLabels = new Dictionary<string,string> {
        ["safe"]     = "آمن",
        ["caution"]  = "انتباه",
        ["moderate"] = "متوسط",
        ["serious"]  = "خطير",
        ["critical"] = "خطر شديد",
        ["unknown"]  = "غير محدد"
    };
    var overallSev = Model.OverallSeverity?.ToLower() ?? "safe";
    if (!sevColors.ContainsKey(overallSev)) overallSev = "safe";
}

@section HeadStyles {
<style>
    .multi-page { padding: 44px 0 60px; }
    .page-header { text-align: center; margin-bottom: 36px; }
    .page-header h2 { font-size: 1.6rem; font-weight: 800; color: white; margin-bottom: 6px; }
    .page-header p { color: rgba(255,255,255,.5); font-size: .9rem; }
    /* Overall summary */
    .overall-card {
        border-radius: 18px; padding: 28px 32px; margin-bottom: 28px;
        display: flex; align-items: center; gap: 20px;
        border: 1.5px solid; animation: fadeInUp .4s ease;
    }
    .overall-card .oc-icon {
        width: 60px; height: 60px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; flex-shrink: 0;
    }
    .overall-card .oc-body { flex: 1; }
    .overall-card .oc-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
    .overall-card .oc-stats {
        display: flex; gap: 20px; flex-wrap: wrap; margin-top: 12px;
    }
    .overall-card .oc-stat {
        display: flex; align-items: center; gap: 6px;
        font-size: .85rem; color: rgba(255,255,255,.7);
    }
    /* Drug tags */
    .drug-tags {
        display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 28px;
    }
    .drug-tag {
        padding: 7px 18px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 20px; font-size: .88rem;
        color: rgba(255,255,255,.8); font-weight: 600;
    }
    /* Pair cards */
    .pair-list { display: flex; flex-direction: column; gap: 16px; }
    .pair-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-right: 4px solid;
        border-radius: 14px; padding: 22px 24px;
        transition: all .25s; animation: fadeInUp .35s ease;
    }
    .pair-card:hover { background: rgba(255,255,255,.07); }
    .pair-card .pc-header {
        display: flex; align-items: center; gap: 14px; margin-bottom: 12px;
    }
    .pair-card .pc-drugs {
        flex: 1; font-size: 1rem; font-weight: 700; color: white;
        display: flex; align-items: center; gap: 10px;
    }
    .pair-card .pc-drugs .vs-chip {
        padding: 2px 8px; background: rgba(255,255,255,.1); border-radius: 6px;
        font-size: .75rem; color: rgba(255,255,255,.5);
    }
    .pair-card .pc-badge {
        padding: 4px 14px; border-radius: 16px;
        font-size: .78rem; font-weight: 700; flex-shrink: 0;
    }
    .pair-card .pc-summary { color: rgba(255,255,255,.7); font-size: .88rem; line-height: 1.7; }
    .pair-card .pc-detail {
        margin-top: 10px; font-size: .83rem; color: rgba(255,255,255,.55); line-height: 1.7;
    }
    .pair-card .pc-alt {
        margin-top: 10px; display: flex; align-items: flex-start; gap: 8px;
        background: rgba(0,201,167,.07); border: 1px solid rgba(0,201,167,.18);
        border-radius: 8px; padding: 9px 12px;
        font-size: .83rem; color: #00c9a7;
    }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@media (max-width: 600px) {
        .pair-card .pc-header { flex-wrap: wrap; }
    }
</style>
}

<div class="multi-page fade-up">
    <div class="container" style="max-width:820px">
        <div class="page-header">
            <h2><i class="fa-solid fa-flask-vial" style="color:#00c9a7; margin-left:8px"></i> نتائج الفحص المتعدد</h2>
            <p>تم فحص جميع أزواج الأدوية المدخلة</p>
        </div>

        <!-- Overall result -->
        <div class="overall-card"
             style="background:@(sevColors[overallSev])18; border-color:@(sevColors[overallSev])">
            <div class="oc-icon"
                 style="background:@(sevColors[overallSev])22; color:@(sevColors[overallSev])">
                <i class="fa-solid @(overallSev == "critical" ? "fa-skull-crossbones" : overallSev == "serious" ? "fa-circle-exclamation" : overallSev == "moderate" ? "fa-triangle-exclamation" : "fa-circle-check")"></i>
            </div>
            <div class="oc-body">
                <div class="oc-title" style="color:@(sevColors[overallSev])">
                    التقييم الكلي: @(sevLabels.GetValueOrDefault(overallSev,"غير محدد"))
                </div>
                <div style="color:rgba(255,255,255,.7); font-size:.9rem">
                    تم فحص @Model.TotalPairs زوج من الأدوية
                </div>
                <div class="oc-stats">
                    @if (Model.DangerCount > 0)
                    {
                        <span class="oc-stat">
                            <i class="fa-solid fa-circle-exclamation" style="color:#ff4757"></i>
                            @Model.DangerCount تداخل خطير
                        </span>
                    }
                    @if (Model.SafeCount > 0)
                    {
                        <span class="oc-stat">
                            <i class="fa-solid fa-circle-check" style="color:#00c9a7"></i>
                            @Model.SafeCount آمن
                        </span>
                    }
                    <span class="oc-stat">
                        <i class="fa-solid fa-pills" style="color:#60a5fa"></i>
                        @Model.DrugNames.Count أدوية مُدخلة
                    </span>
                </div>
            </div>
        </div>

        <!-- Drug tags -->
        <div class="drug-tags">
            @foreach (var name in Model.DrugNames)
            {
                <span class="drug-tag"><i class="fa-solid fa-capsules" style="color:#00c9a7; margin-left:5px"></i>@name</span>
            }
        </div>

        <!-- Pair results -->
        <div class="pair-list">
            @foreach (var r in Model.Results.OrderByDescending(x => {
                var order = new[]{"safe","caution","moderate","serious","critical"};
                return Array.IndexOf(order, x.Severity?.ToLower() ?? "safe");
            }))
            {
                var rSev = r.Severity?.ToLower() ?? "safe";
                if (!sevColors.ContainsKey(rSev)) rSev = "safe";
                <div class="pair-card" style="border-right-color:@(sevColors[rSev])">
                    <div class="pc-header">
                        <div class="pc-drugs">
                            @r.Drug1
                            <span class="vs-chip">VS</span>
                            @r.Drug2
                        </div>
                        <span class="pc-badge"
                              style="background:@(sevColors[rSev])22; color:@(sevColors[rSev])">
                            @(sevLabels.GetValueOrDefault(rSev,"غير محدد"))
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(r.Summary))
                    {
                        <div class="pc-summary">@r.Summary</div>
                    }
                    @if (!string.IsNullOrEmpty(r.Details))
                    {
                        <div class="pc-detail">@r.Details</div>
                    }
                    @if (!string.IsNullOrEmpty(r.SafeAlternatives))
                    {
                        <div class="pc-alt">
                            <i class="fa-solid fa-lightbulb" style="margin-top:2px; flex-shrink:0"></i>
                            البديل الآمن: @r.SafeAlternatives
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Actions -->
        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:28px">
            <a asp-action="Index" style="flex:1; min-width:150px; padding:13px; background:rgba(255,255,255,.07); border:1.5px solid rgba(255,255,255,.12); border-radius:11px; color:white; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; justify-content:center; gap:8px">
                <i class="fa-solid fa-rotate-right"></i> فحص جديد
            </a>
            <a asp-action="History" style="flex:1; min-width:150px; padding:13px; background:rgba(0,201,167,.12); border:1.5px solid rgba(0,201,167,.25); border-radius:11px; color:#00c9a7; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; justify-content:center; gap:8px">
                <i class="fa-solid fa-clock-rotate-left"></i> السجل
            </a>
        </div>

        <div style="margin-top:18px; padding:10px 14px; background:rgba(255,255,255,.03); border-radius:10px; color:rgba(255,255,255,.3); font-size:.76rem; display:flex; gap:7px; align-items:flex-start">
            <i class="fa-solid fa-circle-info" style="flex-shrink:0; margin-top:1px"></i>
            التحليل لأغراض إرشادية ولا يُغني عن استشارة طبيب أو صيدلاني مختص.
        </div>
    </div>
</div>
