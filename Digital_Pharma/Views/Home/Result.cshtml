@model Digital_Pharma.Models.InteractionAnalysis
@{
    ViewData["Title"] = "نتيجة التحليل";

    var severityMap = new Dictionary<string, (string label, string color, string bg, string icon)>
    {
        ["safe"]     = ("آمن",               "#00c9a7", "rgba(0,201,167,0.12)",   "fa-circle-check"),
        ["caution"]  = ("يستدعي الانتباه",   "#3ecf8e", "rgba(62,207,142,0.12)",  "fa-eye"),
        ["moderate"] = ("تداخل متوسط",       "#ffa502", "rgba(255,165,2,0.12)",   "fa-triangle-exclamation"),
        ["serious"]  = ("تداخل خطير",        "#ff6348", "rgba(255,99,72,0.12)",   "fa-circle-exclamation"),
        ["critical"] = ("خطر شديد",          "#ff4757", "rgba(255,71,87,0.12)",   "fa-skull-crossbones"),
        ["unknown"]  = ("غير محدد",           "#94a3b8", "rgba(148,163,184,0.12)", "fa-question-circle"),
    };
    var sev = Model.Severity?.ToLower() ?? "unknown";
    if (!severityMap.ContainsKey(sev)) sev = "unknown";
    var (sevLabel, sevColor, sevBg, sevIcon) = severityMap[sev];
    bool isCritical = sev == "critical" || sev == "serious";

    var aiContext = $"الدواء الأول: {Model.DisplayDrug1}\nالدواء الثاني: {Model.DisplayDrug2}\nمستوى الخطورة: {sevLabel}\nالملخص: {Model.AnalysisMessage}\nالتفاصيل: {Model.AiDetails}\nالتوصية: {Model.AiRecommendation}";
    var shareUrl = Model.ShareToken != null ? $"/Home/ViewShared?token={Model.ShareToken}" : "";
}

@section HeadStyles {
<style>
    .result-page { padding: 40px 0 60px; }
    /* Critical overlay */
    .critical-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(255,30,50,0.92);
        z-index: 9999; align-items: center; justify-content: center;
        flex-direction: column; text-align: center; padding: 30px;
    }
    .critical-overlay.show { display: flex; }
    .critical-overlay .co-icon {
        font-size: 5rem; color: white; margin-bottom: 20px;
        animation: pulse 1s ease-in-out infinite;
    }
    .critical-overlay h2 { font-size: 2rem; font-weight: 800; color: white; margin-bottom: 16px; }
    .critical-overlay p { font-size: 1.1rem; color: rgba(255,255,255,0.85); max-width: 500px; margin-bottom: 28px; line-height: 1.7; }
    .critical-overlay .btn-acknowledge {
        padding: 16px 40px;
        background: white; color: #ff2234;
        border: none; border-radius: 14px;
        font-family: 'Tajawal', sans-serif; font-size: 1.1rem; font-weight: 800;
        cursor: pointer; transition: all 0.3s;
    }
    .critical-overlay .btn-acknowledge:hover { transform: scale(1.05); }
    @@keyframes pulse {
        0%,100% { transform: scale(1); }
        50% { transform: scale(1.15); }
    }
    /* Header */
    .result-header { text-align: center; margin-bottom: 36px; }
    .result-header h2 { font-size: 1.5rem; font-weight: 700; color: white; margin-bottom: 6px; }
    .result-header .subtitle { color: rgba(255,255,255,0.5); font-size: 0.9rem; }
    /* Drugs banner */
    .drugs-banner {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px; padding: 24px;
        display: flex; align-items: center; justify-content: center; gap: 0;
        margin-bottom: 28px;
    }
    .drug-pill {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 12px; padding: 14px 24px;
        text-align: center; flex: 1; max-width: 200px;
    }
    .drug-pill .dp-label { font-size: 0.75rem; color: rgba(255,255,255,0.4); margin-bottom: 4px; }
    .drug-pill .dp-name  { font-size: 1.05rem; font-weight: 700; color: white; }
    .vs-connector {
        width: 60px; display: flex; flex-direction: column; align-items: center; gap: 4px;
        flex-shrink: 0;
    }
    .vs-line { width: 100%; height: 1px; background: rgba(255,255,255,0.15); }
    .vs-text {
        font-size: 0.75rem; font-weight: 700;
        background: rgba(255,255,255,0.1);
        padding: 4px 8px; border-radius: 6px;
        color: rgba(255,255,255,0.5);
    }
    /* Severity card */
    .severity-card {
        border-radius: 18px; padding: 28px 32px;
        border: 1.5px solid; margin-bottom: 24px;
        display: flex; align-items: flex-start; gap: 20px;
        animation: fadeInUp 0.4s ease;
    }
    .severity-card .sev-icon-wrap {
        width: 60px; height: 60px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; flex-shrink: 0;
    }
    .severity-card .sev-body { flex: 1; }
    .severity-card .sev-badge {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 4px 12px; border-radius: 20px;
        font-size: 0.8rem; font-weight: 700; margin-bottom: 8px;
    }
    .severity-card .sev-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 8px; }
    .severity-card .sev-summary { color: rgba(255,255,255,0.75); font-size: 0.95rem; line-height: 1.7; }
    /* Analysis sections */
    .analysis-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
        margin-bottom: 24px;
    }
    .analysis-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; padding: 22px;
    }
    .analysis-card .ac-header {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 14px;
    }
    .analysis-card .ac-header .ac-icon {
        width: 36px; height: 36px;
        border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.95rem;
    }
    .analysis-card .ac-header .ac-title {
        font-size: 0.9rem; font-weight: 700; color: white;
    }
    .analysis-card .ac-body {
        color: rgba(255,255,255,0.7);
        font-size: 0.9rem; line-height: 1.8;
    }
    /* Alert cards */
    .alert-card {
        border-radius: 12px; padding: 18px 20px;
        margin-bottom: 20px;
        display: flex; align-items: flex-start; gap: 14px;
    }
    .alert-card.conflict {
        background: rgba(255,165,2,0.09);
        border: 1px solid rgba(255,165,2,0.25);
    }
    .alert-card.patient {
        background: rgba(13,110,253,0.08);
        border: 1px solid rgba(13,110,253,0.2);
    }
    .alert-card.alternative {
        background: rgba(0,201,167,0.08);
        border: 1px solid rgba(0,201,167,0.2);
    }
    .alert-card .ac2-icon { font-size: 1.2rem; margin-top: 2px; flex-shrink: 0; }
    .alert-card .ac2-label { font-size: 0.78rem; color: rgba(255,255,255,0.4); margin-bottom: 4px; }
    .alert-card .ac2-text  { color: rgba(255,255,255,0.8); font-size: 0.9rem; line-height: 1.7; }
    /* FDA section */
    .fda-section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px; padding: 20px;
        margin-bottom: 24px;
    }
    .fda-section .fda-title {
        display: flex; align-items: center; gap: 10px;
        font-size: 0.85rem; font-weight: 700;
        color: rgba(255,255,255,0.6);
        margin-bottom: 0; cursor: pointer;
    }
    .fda-section .fda-title i { color: rgba(255,255,255,0.35); }
    .fda-drugs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 16px; }
    .fda-drug-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px; padding: 14px;
    }
    .fda-drug-card .fdk-name { font-size: 0.85rem; font-weight: 700; color: white; margin-bottom: 6px; }
    .fda-drug-card .fdk-generic { font-size: 0.78rem; color: rgba(255,255,255,0.45); margin-bottom: 8px; }
    .fda-drug-card .fdk-interactions {
        font-size: 0.78rem; color: rgba(255,255,255,0.5); line-height: 1.6;
        max-height: 80px; overflow: hidden;
        display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical;
    }
    /* AI Chat */
    .chat-section {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px; padding: 24px;
        margin-bottom: 24px;
    }
    .chat-section .chat-title {
        display: flex; align-items: center; gap: 10px;
        font-size: 0.95rem; font-weight: 700; color: white; margin-bottom: 16px;
    }
    .chat-section .chat-title i { color: #00c9a7; }
    .chat-messages { max-height: 260px; overflow-y: auto; margin-bottom: 14px; }
    .chat-msg {
        padding: 10px 14px; border-radius: 10px; margin-bottom: 10px;
        font-size: 0.88rem; line-height: 1.6;
    }
    .chat-msg.user-msg {
        background: rgba(13,110,253,0.15);
        border: 1px solid rgba(13,110,253,0.2);
        color: #93c5fd; text-align: right; margin-right: 20%;
    }
    .chat-msg.ai-msg {
        background: rgba(0,201,167,0.1);
        border: 1px solid rgba(0,201,167,0.2);
        color: rgba(255,255,255,0.85); margin-left: 20%;
    }
    .chat-input-row { display: flex; gap: 10px; }
    .chat-input-row input {
        flex: 1; padding: 12px 14px;
        background: rgba(255,255,255,0.07);
        border: 1.5px solid rgba(255,255,255,0.12);
        border-radius: 10px; color: white;
        font-family: 'Tajawal', sans-serif; font-size: 0.9rem;
        outline: none; transition: all 0.25s;
    }
    .chat-input-row input:focus {
        border-color: #00c9a7;
        background: rgba(0,201,167,0.07);
    }
    .chat-input-row input::placeholder { color: rgba(255,255,255,0.3); }
    .btn-chat-send {
        padding: 12px 20px;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        border: none; border-radius: 10px;
        color: white; font-family: 'Tajawal', sans-serif;
        font-size: 0.9rem; font-weight: 600;
        cursor: pointer; transition: all 0.25s;
        white-space: nowrap;
    }
    .btn-chat-send:hover { opacity: 0.9; }
    .btn-chat-send:disabled { opacity: 0.5; cursor: not-allowed; }
    /* Action buttons */
    .action-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
    .btn-action {
        flex: 1; min-width: 140px; padding: 13px;
        border-radius: 12px; font-family: 'Tajawal', sans-serif;
        font-size: 0.9rem; font-weight: 600;
        cursor: pointer; text-decoration: none;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        transition: all 0.25s; border: 1.5px solid;
    }
    .btn-action.back {
        background: rgba(255,255,255,0.07);
        border-color: rgba(255,255,255,0.12); color: white;
    }
    .btn-action.back:hover { background: rgba(255,255,255,0.12); color: white; }
    .btn-action.history {
        background: linear-gradient(135deg, rgba(0,201,167,0.2), rgba(13,110,253,0.2));
        border-color: rgba(0,201,167,0.3); color: #00c9a7;
    }
    .btn-action.history:hover { background: rgba(0,201,167,0.25); color: #00c9a7; }
    .btn-action.share {
        background: rgba(99,102,241,0.15);
        border-color: rgba(99,102,241,0.3); color: #a5b4fc;
    }
    .btn-action.share:hover { background: rgba(99,102,241,0.25); color: #a5b4fc; }
    .btn-action.mymeds {
        background: rgba(255,165,2,0.12);
        border-color: rgba(255,165,2,0.25); color: #fbbf24;
    }
    .btn-action.mymeds:hover { background: rgba(255,165,2,0.2); color: #fbbf24; }
    /* AI disclaimer */
    .ai-note {
        padding: 12px 16px;
        background: rgba(255,255,255,0.03);
        border-radius: 10px;
        color: rgba(255,255,255,0.35); font-size: 0.78rem;
        display: flex; align-items: flex-start; gap: 8px;
    }
    .ai-note i { color: rgba(255,255,255,0.25); margin-top: 1px; flex-shrink: 0; }
    /* Share copied toast */
    .toast-msg {
        position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
        background: rgba(0,201,167,0.9); color: white;
        padding: 12px 24px; border-radius: 30px;
        font-size: 0.9rem; font-weight: 600;
        opacity: 0; transition: opacity 0.3s;
        pointer-events: none; z-index: 1000;
    }
    .toast-msg.show { opacity: 1; }
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@media (max-width: 600px) {
        .analysis-grid { grid-template-columns: 1fr; }
        .fda-drugs-grid { grid-template-columns: 1fr; }
        .drugs-banner { flex-direction: column; gap: 10px; }
        .vs-connector .vs-line { display: none; }
        .chat-msg.user-msg { margin-right: 10%; }
        .chat-msg.ai-msg { margin-left: 10%; }
    }
</style>
}

<!-- Critical Danger Overlay -->
@if (isCritical)
{
    <div class="critical-overlay @(sev == "critical" ? "show" : "")" id="criticalOverlay">
        <div class="co-icon">
            <i class="fa-solid fa-skull-crossbones"></i>
        </div>
        <h2>⚠️ تحذير: خطر شديد</h2>
        <p>
            التركيبة بين <strong>@Model.DisplayDrug1</strong> و <strong>@Model.DisplayDrug2</strong> تُشكّل
            خطراً بالغاً قد يهدد الحياة. لا تتناول هذين الدوائين معاً دون استشارة طبيب متخصص فوراً.
        </p>
        <button class="btn-acknowledge" onclick="document.getElementById('criticalOverlay').classList.remove('show')">
            <i class="fa-solid fa-eye"></i> فهمت — اطلع على التفاصيل
        </button>
    </div>
}

<div class="result-page fade-up">
    <div class="container" style="max-width:820px">
        <div class="result-header">
            <h2><i class="fa-solid fa-flask-vial" style="color:#00c9a7; margin-left:8px"></i> نتيجة تحليل التداخل الدوائي</h2>
            <p class="subtitle">تحليل مدعوم بالذكاء الاصطناعي مع بيانات FDA</p>
        </div>

        <!-- Drugs Banner -->
        <div class="drugs-banner">
            <div class="drug-pill">
                <div class="dp-label">الدواء الأول</div>
                <div class="dp-name">@Model.DisplayDrug1</div>
            </div>
            <div class="vs-connector">
                <div class="vs-line"></div>
                <div class="vs-text">VS</div>
                <div class="vs-line"></div>
            </div>
            <div class="drug-pill">
                <div class="dp-label">الدواء الثاني</div>
                <div class="dp-name">@Model.DisplayDrug2</div>
            </div>
        </div>

        <!-- Severity Result Card -->
        <div class="severity-card" style="background:@sevBg; border-color:@sevColor">
            <div class="sev-icon-wrap" style="background:@(sevColor)22; color:@sevColor">
                <i class="fa-solid @sevIcon"></i>
            </div>
            <div class="sev-body">
                <div class="sev-badge" style="background:@(sevColor)22; color:@sevColor">
                    <i class="fa-solid fa-circle" style="font-size:0.5rem"></i>
                    @sevLabel
                </div>
                <div class="sev-title" style="color:@sevColor">
                    @(Model.InteractionFound ? "تم اكتشاف تداخل دوائي" : "لم يُكتشف تداخل خطير")
                </div>
                <div class="sev-summary">@Model.AnalysisMessage</div>
            </div>
        </div>

        <!-- AI Analysis Grid -->
        @if (Model.AiSuccess && (!string.IsNullOrEmpty(Model.AiDetails) || !string.IsNullOrEmpty(Model.AiRecommendation)))
        {
            <div class="analysis-grid">
                @if (!string.IsNullOrEmpty(Model.AiDetails))
                {
                    <div class="analysis-card">
                        <div class="ac-header">
                            <div class="ac-icon" style="background:rgba(99,179,237,0.15); color:#63b3ed">
                                <i class="fa-solid fa-microscope"></i>
                            </div>
                            <div class="ac-title">التفاصيل الطبية</div>
                        </div>
                        <div class="ac-body">@Model.AiDetails</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.AiRecommendation))
                {
                    <div class="analysis-card">
                        <div class="ac-header">
                            <div class="ac-icon" style="background:rgba(0,201,167,0.15); color:#00c9a7">
                                <i class="fa-solid fa-clipboard-check"></i>
                            </div>
                            <div class="ac-title">التوصية الطبية</div>
                        </div>
                        <div class="ac-body">@Model.AiRecommendation</div>
                    </div>
                }
            </div>
        }

        <!-- Saved Med Conflicts -->
        @if (!string.IsNullOrEmpty(Model.AiSavedMedConflicts))
        {
            <div class="alert-card conflict">
                <i class="fa-solid fa-triangle-exclamation ac2-icon" style="color:#ffa502"></i>
                <div>
                    <div class="ac2-label">⚠️ تعارض مع أدويتك المحفوظة</div>
                    <div class="ac2-text">@Model.AiSavedMedConflicts</div>
                </div>
            </div>
        }

        <!-- Patient-specific notes -->
        @if (!string.IsNullOrEmpty(Model.AiPatientNotes))
        {
            <div class="alert-card patient">
                <i class="fa-solid fa-user-shield ac2-icon" style="color:#60a5fa"></i>
                <div>
                    <div class="ac2-label">ملاحظات خاصة بحالتك الصحية</div>
                    <div class="ac2-text">@Model.AiPatientNotes</div>
                </div>
            </div>
        }

        <!-- Safe Alternatives -->
        @if (!string.IsNullOrEmpty(Model.AiSafeAlternatives))
        {
            <div class="alert-card alternative">
                <i class="fa-solid fa-lightbulb ac2-icon" style="color:#00c9a7"></i>
                <div>
                    <div class="ac2-label">البديل الآمن المقترح</div>
                    <div class="ac2-text">@Model.AiSafeAlternatives</div>
                </div>
            </div>
        }

        <!-- AI Chat -->
        <div class="chat-section">
            <div class="chat-title">
                <i class="fa-solid fa-comments"></i>
                استفسر عن هذا التحليل
            </div>
            <div class="chat-messages" id="chatMessages">
                <div class="chat-msg ai-msg">
                    مرحباً! يمكنك سؤالي عن أي تفاصيل تخص هذا التحليل الدوائي. على سبيل المثال: "ما الجرعة الآمنة؟" أو "ما البديل الأفضل؟"
                </div>
            </div>
            <div class="chat-input-row">
                <input type="text" id="chatInput" placeholder="اكتب سؤالك هنا..." />
                <button class="btn-chat-send" id="chatSendBtn" onclick="sendChat()">
                    <i class="fa-solid fa-paper-plane"></i> إرسال
                </button>
            </div>
        </div>

        <!-- FDA Data (collapsible) -->
        <div class="fda-section">
            <div class="fda-title" onclick="toggleFda()">
                <i class="fa-solid fa-chevron-down" id="fdaChevron"></i>
                بيانات FDA المرجعية
                <span style="margin-right:auto; font-size:0.75rem; background:rgba(255,255,255,0.07); padding:2px 10px; border-radius:20px">
                    مرجعي فقط
                </span>
            </div>
            <div id="fdaBody" style="display:none">
                <div class="fda-drugs-grid">
                    <div class="fda-drug-card">
                        <div class="fdk-name">@(Model.Drug1?.OpenFda?.BrandName?.FirstOrDefault() ?? Model.DisplayDrug1)</div>
                        <div class="fdk-generic">@(Model.Drug1?.OpenFda?.GenericName?.FirstOrDefault() ?? "—")</div>
                        <div class="fdk-interactions">
                            @if (Model.Drug1?.DrugInteractions != null && Model.Drug1.DrugInteractions.Any())
                            { @string.Join(" ", Model.Drug1.DrugInteractions)[..Math.Min(300, string.Join(" ", Model.Drug1.DrugInteractions).Length)] }
                            else
                            { <text>لا تتوفر بيانات تفاعل من FDA لهذا الدواء</text> }
                        </div>
                    </div>
                    <div class="fda-drug-card">
                        <div class="fdk-name">@(Model.Drug2?.OpenFda?.BrandName?.FirstOrDefault() ?? Model.DisplayDrug2)</div>
                        <div class="fdk-generic">@(Model.Drug2?.OpenFda?.GenericName?.FirstOrDefault() ?? "—")</div>
                        <div class="fdk-interactions">
                            @if (Model.Drug2?.DrugInteractions != null && Model.Drug2.DrugInteractions.Any())
                            { @string.Join(" ", Model.Drug2.DrugInteractions)[..Math.Min(300, string.Join(" ", Model.Drug2.DrugInteractions).Length)] }
                            else
                            { <text>لا تتوفر بيانات تفاعل من FDA لهذا الدواء</text> }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="action-row">
            <a asp-action="Index" class="btn-action back">
                <i class="fa-solid fa-rotate-right"></i> فحص جديد
            </a>
            <a asp-action="History" class="btn-action history">
                <i class="fa-solid fa-clock-rotate-left"></i> السجل
            </a>
            <a asp-action="MyMedications" class="btn-action mymeds">
                <i class="fa-solid fa-pills"></i> أدويتي
            </a>
            @if (!string.IsNullOrEmpty(shareUrl))
            {
                <button class="btn-action share" onclick="copyShareLink()">
                    <i class="fa-solid fa-share-nodes"></i> مشاركة النتيجة
                </button>
            }
        </div>

        <div class="ai-note">
            <i class="fa-solid fa-circle-info"></i>
            هذا التحليل لأغراض إرشادية فقط ولا يُغني عن استشارة طبيب أو صيدلاني متخصص. يُرجى دائماً مراجعة مقدّم الرعاية الصحية قبل تناول أي دواء.
        </div>
    </div>
</div>

<div class="toast-msg" id="toastMsg">✓ تم نسخ رابط المشاركة</div>

@section Scripts {
<script>
    const AI_CONTEXT = @Json.Serialize(aiContext);
    const SHARE_URL  = @Json.Serialize(shareUrl);

    function toggleFda() {
        var body = document.getElementById('fdaBody');
        var chevron = document.getElementById('fdaChevron');
        body.style.display = body.style.display === 'none' ? 'block' : 'none';
        chevron.style.transform = body.style.display === 'block' ? 'rotate(180deg)' : 'rotate(0)';
    }

    function copyShareLink() {
        var fullUrl = window.location.origin + SHARE_URL;
        navigator.clipboard.writeText(fullUrl).then(function() {
            var t = document.getElementById('toastMsg');
            t.classList.add('show');
            setTimeout(function() { t.classList.remove('show'); }, 2500);
        }).catch(function() {
            prompt('انسخ الرابط:', window.location.origin + SHARE_URL);
        });
    }

    async function sendChat() {
        var input = document.getElementById('chatInput');
        var btn = document.getElementById('chatSendBtn');
        var question = input.value.trim();
        if (!question) return;

        var msgs = document.getElementById('chatMessages');

        // Add user message
        msgs.innerHTML += '<div class="chat-msg user-msg">' + escapeHtml(question) + '</div>';
        input.value = '';
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> جارٍ الإجابة...';
        msgs.scrollTop = msgs.scrollHeight;

        try {
            var response = await fetch('/Home/AiChat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'question=' + encodeURIComponent(question) + '&context=' + encodeURIComponent(AI_CONTEXT)
            });
            var data = await response.json();
            var answer = data.success ? data.answer : 'حدث خطأ، يرجى المحاولة مجدداً.';
            msgs.innerHTML += '<div class="chat-msg ai-msg">' + escapeHtml(answer) + '</div>';
        } catch(e) {
            msgs.innerHTML += '<div class="chat-msg ai-msg">حدث خطأ في الاتصال.</div>';
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-paper-plane"></i> إرسال';
        msgs.scrollTop = msgs.scrollHeight;
    }

    document.getElementById('chatInput').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') sendChat();
    });

    function escapeHtml(text) {
        return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
                   .replace(/"/g,'&quot;').replace(/'/g,'&#039;').replace(/\n/g,'<br>');
    }
</script>
}
