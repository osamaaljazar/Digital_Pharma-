@{
    ViewData["Title"] = "فحص التداخل الدوائي";
    var userName = Context.Session.GetString("UserName") ?? "المستخدم";
}

@section HeadStyles {
<style>
    .hero-section {
        padding: 60px 0 40px;
        text-align: center;
    }
    .hero-section .badge-pill {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(0,201,167,0.15);
        border: 1px solid rgba(0,201,167,0.3);
        color: #00c9a7;
        padding: 6px 18px; border-radius: 50px;
        font-size: 0.85rem; font-weight: 600;
        margin-bottom: 20px;
    }
    .hero-section h1 {
        font-size: 2.8rem; font-weight: 800; color: white;
        line-height: 1.2; margin-bottom: 16px;
    }
    .hero-section h1 span {
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-section p { color: rgba(255,255,255,0.6); font-size: 1.1rem; max-width: 520px; margin: 0 auto 40px; }
    /* Check form */
    .check-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 20px;
        padding: 40px;
        max-width: 700px; margin: 0 auto;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }
    .drug-inputs-row {
        display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px;
        align-items: center; margin-bottom: 24px;
    }
    .vs-badge {
        width: 42px; height: 42px;
        background: linear-gradient(135deg, rgba(0,201,167,0.3), rgba(13,110,253,0.3));
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #00c9a7; font-weight: 800; font-size: 0.85rem;
        flex-shrink: 0;
    }
    .drug-input-group label {
        display: flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,0.7); font-size: 0.85rem;
        font-weight: 600; margin-bottom: 8px;
    }
    .drug-input-group label .lbl-dot {
        width: 8px; height: 8px; border-radius: 50%;
    }
    .drug-input-group label .lbl-dot.dot-1 { background: #00c9a7; }
    .drug-input-group label .lbl-dot.dot-2 { background: #0d6efd; }
    .drug-input-group input {
        width: 100%; padding: 14px 16px;
        background: rgba(255,255,255,0.07);
        border: 1.5px solid rgba(255,255,255,0.12);
        border-radius: 12px; color: white;
        font-family: 'Tajawal', sans-serif; font-size: 1rem;
        outline: none; transition: all 0.25s;
        text-align: center;
    }
    .drug-input-group input::placeholder { color: rgba(255,255,255,0.3); }
    .drug-input-group input:focus {
        border-color: #00c9a7;
        background: rgba(0,201,167,0.08);
        box-shadow: 0 0 0 4px rgba(0,201,167,0.12);
    }
    .btn-check-main {
        width: 100%; padding: 16px;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        border: none; border-radius: 14px;
        color: white; font-family: 'Tajawal', sans-serif;
        font-size: 1.1rem; font-weight: 700;
        cursor: pointer; transition: all 0.3s;
        box-shadow: 0 8px 25px rgba(0,201,167,0.35);
        display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .btn-check-main:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 35px rgba(0,201,167,0.45);
    }
    .btn-check-main:active { transform: translateY(0); }
    .btn-check-main .spinner {
        display: none; width: 20px; height: 20px;
        border: 2.5px solid rgba(255,255,255,0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    /* Error */
    .error-msg {
        background: rgba(255,71,87,0.12);
        border: 1px solid rgba(255,71,87,0.3);
        color: #ff6b7a; border-radius: 10px;
        padding: 12px 16px; margin-top: 16px;
        font-size: 0.9rem; display: flex; gap: 8px; align-items: center;
    }
    /* Info strip */
    .info-strip {
        display: flex; gap: 10px; margin-top: 20px;
        padding: 14px 16px;
        background: rgba(255,255,255,0.03);
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.07);
    }
    .info-strip .strip-item {
        flex: 1; display: flex; align-items: center; gap: 8px;
        color: rgba(255,255,255,0.5); font-size: 0.8rem;
    }
    .info-strip .strip-item i { color: #00c9a7; }
    /* Stats row */
    .stats-row {
        display: flex; justify-content: center; gap: 40px;
        margin-top: 50px;
    }
    .stat-item { text-align: center; }
    .stat-item .num {
        font-size: 2rem; font-weight: 800;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .stat-item .lbl { color: rgba(255,255,255,0.5); font-size: 0.85rem; margin-top: 4px; }
    @@media (max-width: 600px) {
        .drug-inputs-row { grid-template-columns: 1fr; }
        .vs-badge { display: none; }
        .hero-section h1 { font-size: 1.8rem; }
        .check-card { padding: 24px 18px; }
        .stats-row { gap: 20px; }
    }
</style>
}

<div class="hero-section fade-up">
    <div class="container">
        <div class="badge-pill">
            <i class="fa-solid fa-robot"></i> مدعوم بالذكاء الاصطناعي
        </div>
        <h1>فحص <span>التداخل الدوائي</span><br>بدقة وذكاء</h1>
        <p>أدخل اسم الدوائين وسيحلّل الذكاء الاصطناعي التفاعل المحتمل بينهما مع مراعاة حالتك الصحية الخاصة</p>

        <div class="check-card">
            <form asp-action="CheckInteraction" method="post" id="checkForm">
                <div class="drug-inputs-row">
                    <div class="drug-input-group">
                        <label>
                            <span class="lbl-dot dot-1"></span>
                            الدواء الأول
                        </label>
                        <input type="text" name="drugName1" id="drug1"
                               placeholder="مثال: Aspirin" required autocomplete="off" />
                    </div>
                    <div class="vs-badge">VS</div>
                    <div class="drug-input-group">
                        <label>
                            <span class="lbl-dot dot-2"></span>
                            الدواء الثاني
                        </label>
                        <input type="text" name="drugName2" id="drug2"
                               placeholder="مثال: Warfarin" required autocomplete="off" />
                    </div>
                </div>

                <button type="submit" class="btn-check-main" id="submitBtn">
                    <div class="spinner" id="spinner"></div>
                    <i class="fa-solid fa-magnifying-glass-plus" id="searchIcon"></i>
                    <span id="btnText">بدء التحليل الذكي</span>
                </button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    @ViewBag.Error
                </div>
            }

            <div class="info-strip">
                <div class="strip-item">
                    <i class="fa-solid fa-brain"></i>
                    <span>تحليل AI شامل</span>
                </div>
                <div class="strip-item">
                    <i class="fa-solid fa-database"></i>
                    <span>بيانات FDA</span>
                </div>
                <div class="strip-item">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>مخصّص لحالتك</span>
                </div>
                <div class="strip-item">
                    <i class="fa-solid fa-bolt"></i>
                    <span>نتيجة فورية</span>
                </div>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-item">
                <div class="num">10K+</div>
                <div class="lbl">دواء في قاعدة البيانات</div>
            </div>
            <div class="stat-item">
                <div class="num">99%</div>
                <div class="lbl">دقة التحليل</div>
            </div>
            <div class="stat-item">
                <div class="num">&lt;3s</div>
                <div class="lbl">وقت الاستجابة</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('checkForm').addEventListener('submit', function() {
        document.getElementById('spinner').style.display = 'block';
        document.getElementById('searchIcon').style.display = 'none';
        document.getElementById('btnText').textContent = 'جارٍ التحليل...';
        document.getElementById('submitBtn').disabled = true;
    });
</script>
}
