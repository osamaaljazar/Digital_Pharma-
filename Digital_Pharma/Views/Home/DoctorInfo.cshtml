@model Digital_Pharma.Models.Doctor    
    <div class="auth-container" id="doctorContainer">

    <!-- Left Side (Overlay/Text) -->
    <div class="overlay-area">
        <div class="overlay-panel overlay-left">
            <h1 style="color:white;">Welcome!</h1>
            <p style="color:white;">You can fill your doctor information anytime</p>
            <button class="btn ghost" id="showForm">Fill Information</button>
        </div>
        <div class="overlay-panel overlay-right">
            <h1 style="color:white;">Doctor Form</h1>
            <p style="color:white;">Enter your professional details below</p>
            <button class="btn ghost" id="hideForm">Back</button>
        </div>
    </div>
    <!-- Right Side (Form) -->
    <div class="form-area">
        <div class="form-container signup-container">
            <form asp-action="DoctorInfo" method="post">
                <h1>Doctor Information</h1>

                <div class="input-box">
                    <input asp-for="FullName" placeholder="Full Name" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="input-box">
                    <input asp-for="LicenseNumber" placeholder="License Number" required />
                    <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                </div>

                <div class="input-box">
                    <input asp-for="Specialization" placeholder="Specialization" required />
                    <span asp-validation-for="Specialization" class="text-danger"></span>
                </div>

                <button type="submit" class="btn">Save</button>
            </form>
        </div>
    </div>
</div>


<style>
    /* نفس CSS الخاص بالـ Login/SignUp مع تغيير IDs */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: Arial,sans-serif;
    }

    #doctorContainer {
        width: 900px;
        height: 600px;
        margin: 50px auto;
        display: flex;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        background-color: #fff;
    }

        #doctorContainer .overlay-area {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            background-color: #1a1a3d;
        }

        #doctorContainer .overlay-panel {
            position: absolute;
            top: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px;
            color: white;
            background-color: transparent;
            transition: transform 0.6s ease, opacity 0.6s ease;
            border-radius: 0 20px 20px 0;
        }

            #doctorContainer .overlay-panel .btn.ghost {
                background: transparent;
                border: 2px solid white;
                color: white;
                cursor: pointer;
            }

        #doctorContainer .overlay-left {
            transform: translateX(0);
            opacity: 1;
        }

        #doctorContainer .overlay-right {
            transform: translateX(100%);
            opacity: 0;
        }

        #doctorContainer .form-area {
            width: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        #doctorContainer .form-container {
            width: 80%;
            max-width: 400px;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
            transition: transform 0.6s ease;
            background-color: white;
            color: #1a1a3d;
            border-radius: 10px;
        }

        #doctorContainer .signup-container {
            transform: translateX(100%);
        }

        #doctorContainer.right-panel-active .signup-container {
            transform: translateX(0);
        }

        #doctorContainer.right-panel-active .overlay-left {
            transform: translateX(-100%);
            opacity: 0;
        }

        #doctorContainer.right-panel-active .overlay-right {
            transform: translateX(0);
            opacity: 1;
        }

        #doctorContainer .input-box {
            position: relative;
            width: 100%;
            margin-bottom: 15px;
        }

            #doctorContainer .input-box input {
                width: 100%;
                padding: 12px;
                border-radius: 10px;
                border: 1px solid #ddd;
                color: #1a1a3d;
            }

        #doctorContainer .btn {
            margin-top: 20px;
            padding: 12px 45px;
            border: none;
            border-radius: 10px;
            background-color: #2575fc;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            #doctorContainer .btn:hover {
                transform: scale(1.05);
                box-shadow: 0 8px 20px rgba(37,117,252,0.4);
            }
</style>

<script>
    const showForm = document.getElementById("showForm");
    const hideForm = document.getElementById("hideForm");
    const container = document.getElementById("doctorContainer");

    showForm.addEventListener("click", ()=> container.classList.add("right-panel-active"));
    hideForm.addEventListener("click", ()=> container.classList.remove("right-panel-active"));
</script>
