@{
    Layout = null;
    ViewData["Title"] = "Welcome Page";
}

<!-- Main Container -->
<div class="welcome-page-container">

    <!-- زر Account أعلى الصفحة -->
    <div class="top-buttons">
        <a href="/Home/Account" class="account-btn">Account</a>
    </div>

    <!-- Welcome Section -->
    <div class="welcome-content text-center">
        <h1 class="display-3">💊 Welcome to Digital Pharma</h1>
        <p class="lead mt-3">
            Check drug interactions, manage your health, and get professional insights.
        </p>
    </div>

    <!-- ===== Image Slider ===== -->
    <div class="slider-container">
        <img class="slide active" src="https://png.pngtree.com/background/20230617/original/pngtree-pharmaceutical-pills-in-blue-assorted-capsules-tablets-and-3d-renders-picture-image_3700421.jpg" />
        <img class="slide" src="https://png.pngtree.com/thumb_back/fh260/background/20231004/pngtree-rendering-of-medication-capsules-and-container-as-seen-from-above-image_13549804.png" />
        <img class="slide" src="https://cdn.arabsstock.com/uploads/images/96080/og-AVbZIiW5dr.jpeg" />
    </div>

    <!-- About Us Section -->
    <div class="about-us-container text-center">
        <h2>About Us</h2>
        <p class="lead mx-auto">
            Digital Pharma is a modern digital platform designed to help users
            and healthcare professionals easily check drug interactions and
            access reliable pharmaceutical information. Our mission is to
            improve medication safety and support better healthcare decisions.
        </p>
    </div>

    <!-- Mid-page copyright -->
    @* <div class="mid-footer text-center">
        © 2025 - Digital Pharma - Privacy
    </div> *@

</div>

<style>
    /* ===== Base ===== */
    body, html {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #1a1a3d;
        color: white;
        height: 100%;
    }

    /* ===== Main Container ===== */
    .welcome-page-container {
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh; /* يملأ الشاشة بالكامل */
        display: flex;
        flex-direction: column;
        justify-content: center; /* محتوى Welcome بالوسط عمودياً */
        align-items: center; /* محتوى Welcome بالوسط أفقياً */
        padding: 20px;
        box-sizing: border-box;
    }

    /* ===== Account Button ===== */
    .top-buttons {
        width: 100%;
        text-align: right;
        margin-bottom: 40px;
        padding-right: 20px;
    }

    .account-btn {
        font-weight: bold;
        padding: 6px 16px;
        font-size: 14px;
        border-radius: 8px;
        background-color: #2575fc;
        color: white;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .account-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 15px rgba(0,0,0,0.4);
            color: white;
        }

    /* ===== Welcome Section ===== */
    .welcome-content {
        padding-bottom: 50px;
    }

        .welcome-content h1 {
            font-size: 3rem;
        }

        .welcome-content p {
            font-size: 1.25rem;
        }

    /* ===== Slider ===== */
    .slider-container {
        width: 80%;
        max-width: 900px;
        height: 300px;
        margin: 0 auto 50px;
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }

    .slide {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

        .slide.active {
            opacity: 1;
        }

    /* ===== About Us ===== */
    .about-us-container {
        background-color: #1a1a3d;
        color: white;
        padding: 80px 20px 40px;
        border-radius: 16px;
        text-align: center;
        margin-bottom: 50px;
    }

        .about-us-container h2 {
            margin-bottom: 20px;
            font-size: 2rem;
        }

        .about-us-container p {
            font-size: 1.1rem;
            line-height: 1.8;
            max-width: 700px;
            margin: 0 auto;
        }

    /* Mid-page copyright */
    /* .mid-footer {
        margin-bottom:0px;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.7);
    } */
</style>

<script>
    const slides = document.querySelectorAll('.slide');
    let currentSlide = 0;

    setInterval(() => {
        slides[currentSlide].classList.remove('active');
        currentSlide = (currentSlide + 1) % slides.length;
        slides[currentSlide].classList.add('active');
    }, 5000);
</script>


