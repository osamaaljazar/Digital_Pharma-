@model Digital_Pharma.Models.User
@{
    ViewData["Title"] = "حسابي";
    var genderLabel = Model?.Gender == "female" ? "أنثى" : (Model?.Gender == "male" ? "ذكر" : "غير محدد");
    var genderIcon  = Model?.Gender == "female" ? "fa-venus" : "fa-mars";
}

@section HeadStyles {
<style>
    .account-page { padding: 44px 0 60px; }
    /* Profile header */
    .profile-header {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 20px; padding: 30px 32px;
        display: flex; align-items: center; gap: 24px;
        margin-bottom: 28px;
        animation: fadeInUp 0.4s ease;
    }
    .avatar-circle {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.7rem; color: white; font-weight: 800;
        flex-shrink: 0;
        box-shadow: 0 8px 20px rgba(0,201,167,0.3);
    }
    .profile-header .ph-info h3 { font-size: 1.3rem; font-weight: 800; color: white; margin-bottom: 4px; }
    .profile-header .ph-info .ph-email { color: rgba(255,255,255,0.5); font-size: 0.88rem; }
    .profile-header .ph-tags { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .ph-tag {
        padding: 4px 12px; border-radius: 16px;
        font-size: 0.78rem; font-weight: 600;
        display: flex; align-items: center; gap: 5px;
    }
    /* Stats */
    .account-stats {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
        margin-bottom: 28px;
    }
    .acc-stat {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; padding: 22px;
        text-align: center;
    }
    .acc-stat .as-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; margin: 0 auto 10px;
    }
    .acc-stat .as-num { font-size: 1.8rem; font-weight: 800; color: white; }
    .acc-stat .as-lbl { font-size: 0.78rem; color: rgba(255,255,255,0.45); margin-top: 2px; }
    /* Section cards */
    .section-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px; padding: 26px 28px;
        margin-bottom: 20px;
    }
    .section-card .sc-title {
        display: flex; align-items: center; gap: 10px;
        font-size: 1rem; font-weight: 700; color: white; margin-bottom: 20px;
    }
    .section-card .sc-title i { color: #00c9a7; }
    /* Form fields */
    .edit-field { margin-bottom: 16px; }
    .edit-field label {
        display: flex; align-items: center; gap: 7px;
        color: rgba(255,255,255,0.65); font-size: 0.85rem;
        font-weight: 600; margin-bottom: 8px;
    }
    .edit-field label i { color: #00c9a7; }
    .edit-field textarea,
    .edit-field select {
        width: 100%; padding: 12px 16px;
        background: rgba(255,255,255,0.07);
        border: 1.5px solid rgba(255,255,255,0.12);
        border-radius: 11px; color: white;
        font-family: 'Tajawal', sans-serif; font-size: 0.93rem;
        outline: none; transition: all 0.25s;
        resize: vertical;
    }
    .edit-field select option { background: #1e293b; }
    .edit-field textarea::placeholder { color: rgba(255,255,255,0.3); }
    .edit-field textarea:focus,
    .edit-field select:focus {
        border-color: #00c9a7;
        background: rgba(0,201,167,0.07);
        box-shadow: 0 0 0 3px rgba(0,201,167,0.12);
    }
    /* Pregnant toggle */
    .pregnant-row {
        display: none;
        align-items: center; gap: 14px;
        padding: 14px 16px;
        background: rgba(255,107,157,0.07);
        border: 1px solid rgba(255,107,157,0.18);
        border-radius: 10px; margin-top: 8px;
    }
    .pregnant-row.visible { display: flex; }
    .toggle-switch { position: relative; width: 48px; height: 26px; }
    .toggle-switch input { opacity: 0; width:0; height:0; }
    .toggle-slider {
        position: absolute; inset: 0;
        background: rgba(255,255,255,0.15);
        border-radius: 26px; cursor: pointer; transition: 0.3s;
    }
    .toggle-slider::before {
        content: ''; position: absolute;
        width: 18px; height: 18px; left: 4px; bottom: 4px;
        background: white; border-radius: 50%; transition: 0.3s;
    }
    .toggle-switch input:checked + .toggle-slider { background: #ff6b9d; }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(22px); }
    /* Save button */
    .btn-save {
        padding: 13px 32px;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        border: none; border-radius: 11px;
        color: white; font-family: 'Tajawal', sans-serif;
        font-size: 0.95rem; font-weight: 700;
        cursor: pointer; transition: all 0.3s;
        box-shadow: 0 6px 18px rgba(0,201,167,0.3);
        display: flex; align-items: center; gap: 8px;
    }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(0,201,167,0.4); }
    /* Info row */
    .info-row {
        display: flex; align-items: center; gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .ir-icon {
        width: 32px; height: 32px; border-radius: 8px;
        background: rgba(255,255,255,0.07);
        display: flex; align-items: center; justify-content: center;
        color: rgba(255,255,255,0.5); font-size: 0.85rem;
        flex-shrink: 0;
    }
    .info-row .ir-label { font-size: 0.8rem; color: rgba(255,255,255,0.4); }
    .info-row .ir-value { font-size: 0.93rem; color: white; font-weight: 500; }
    @@keyframes fadeInUp {
        from { opacity:0; transform:translateY(16px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@media (max-width: 600px) {
        .account-stats { grid-template-columns: 1fr 1fr; }
        .profile-header { flex-direction: column; text-align: center; }
        .profile-header .ph-tags { justify-content: center; }
    }
</style>
}

<div class="account-page fade-up">
    <div class="container" style="max-width:780px">
        <!-- Profile header -->
        <div class="profile-header">
            <div class="avatar-circle">
                @(Model?.UserName?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div class="ph-info">
                <h3>@Model?.UserName</h3>
                <div class="ph-email">@Model?.Email</div>
                <div class="ph-tags">
                    <span class="ph-tag" style="background:rgba(0,201,167,0.12); color:#00c9a7">
                        <i class="fa-solid @genderIcon"></i> @genderLabel
                    </span>
                    <span class="ph-tag" style="background:rgba(13,110,253,0.12); color:#60a5fa">
                        <i class="fa-solid fa-cake-candles"></i> @Model?.Age سنة
                    </span>
                    @if (Model?.IsMarried == true)
                    {
                        <span class="ph-tag" style="background:rgba(139,92,246,0.12); color:#a78bfa">
                            <i class="fa-solid fa-ring"></i> متزوج/ة
                        </span>
                    }
                    @if (Model?.IsPregnant == true)
                    {
                        <span class="ph-tag" style="background:rgba(255,107,157,0.12); color:#ff6b9d">
                            <i class="fa-solid fa-baby"></i> حامل
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="account-stats">
            <div class="acc-stat">
                <div class="as-icon" style="background:rgba(0,201,167,0.15); color:#00c9a7">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>
                <div class="as-num">@ViewBag.SearchCount</div>
                <div class="as-lbl">إجمالي عمليات الفحص</div>
            </div>
            <div class="acc-stat">
                <div class="as-icon" style="background:rgba(255,71,87,0.15); color:#ff4757">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="as-num">@ViewBag.DangerCount</div>
                <div class="as-lbl">تداخلات خطيرة مكتشفة</div>
            </div>
            <div class="acc-stat">
                <div class="as-icon" style="background:rgba(255,165,2,0.15); color:#fbbf24">
                    <i class="fa-solid fa-pills"></i>
                </div>
                <div class="as-num">@ViewBag.MedCount</div>
                <div class="as-lbl">أدوية محفوظة</div>
            </div>
        </div>

        <!-- Account info -->
        <div class="section-card">
            <div class="sc-title"><i class="fa-solid fa-circle-user"></i> معلومات الحساب</div>
            <div class="info-row">
                <div class="ir-icon"><i class="fa-solid fa-user"></i></div>
                <div>
                    <div class="ir-label">الاسم</div>
                    <div class="ir-value">@Model?.UserName</div>
                </div>
            </div>
            <div class="info-row">
                <div class="ir-icon"><i class="fa-solid fa-envelope"></i></div>
                <div>
                    <div class="ir-label">البريد الإلكتروني</div>
                    <div class="ir-value">@Model?.Email</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model?.PhoneNumber))
            {
                <div class="info-row">
                    <div class="ir-icon"><i class="fa-solid fa-phone"></i></div>
                    <div>
                        <div class="ir-label">رقم الجوال</div>
                        <div class="ir-value">@Model.PhoneNumber</div>
                    </div>
                </div>
            }
            <div class="info-row">
                <div class="ir-icon"><i class="fa-solid fa-calendar"></i></div>
                <div>
                    <div class="ir-label">تاريخ الميلاد</div>
                    <div class="ir-value">@Model?.DateOfBirth.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Health profile editor -->
        <div class="section-card">
            <div class="sc-title"><i class="fa-solid fa-heart-pulse"></i> الملف الصحي</div>
            <form asp-action="UpdateProfile" method="post">
                <div class="edit-field">
                    <label><i class="fa-solid fa-venus-mars"></i> الجنس</label>
                    <select name="gender" id="genderSel">
                        <option value="male"   selected="@(Model?.Gender == "male"   ? "selected" : null)">ذكر</option>
                        <option value="female" selected="@(Model?.Gender == "female" ? "selected" : null)">أنثى</option>
                    </select>
                </div>

                <!-- Marriage status (female only) -->
                <div class="pregnant-row @(Model?.Gender == "female" ? "visible" : "")" id="marriedRow"
                     style="background:rgba(139,92,246,0.07); border-color:rgba(139,92,246,0.18); margin-bottom:8px">
                    <span style="color:rgba(255,255,255,0.65); font-size:0.88rem"><i class="fa-solid fa-ring" style="color:#a78bfa"></i> متزوجة؟</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="isMarried" id="marriedChk"
                               value="true" @(Model?.IsMarried == true ? "checked" : "") />
                        <span class="toggle-slider" style=""></span>
                    </label>
                    <span id="mrLabel" style="color:rgba(255,255,255,0.55); font-size:0.85rem">
                        @(Model?.IsMarried == true ? "نعم" : "لا")
                    </span>
                </div>

                <div class="pregnant-row @(Model?.Gender == "female" && Model?.IsMarried == true ? "visible" : "")" id="pregnantRow">
                    <span style="color:rgba(255,255,255,0.65); font-size:0.88rem"><i class="fa-solid fa-baby" style="color:#ff6b9d"></i> حامل؟</span>
                    <label class="toggle-switch">
                        <input type="checkbox" name="isPregnant" id="pregnantChk"
                               value="true" @(Model?.IsPregnant == true ? "checked" : "") />
                        <span class="toggle-slider"></span>
                    </label>
                    <span id="pgLabel" style="color:rgba(255,255,255,0.55); font-size:0.85rem">
                        @(Model?.IsPregnant == true ? "نعم" : "لا")
                    </span>
                </div>

                <div class="edit-field">
                    <label><i class="fa-solid fa-notes-medical"></i> الأمراض المزمنة أو الحالات الصحية</label>
                    <textarea name="medicalConditions" rows="3"
                              placeholder="مثال: السكري، ضغط الدم المرتفع، أمراض القلب...">@Model?.MedicalConditions</textarea>
                </div>

                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-floppy-disk"></i> حفظ التغييرات
                </button>
            </form>
        </div>

        <!-- Quick links -->
        <div class="section-card">
            <div class="sc-title"><i class="fa-solid fa-link"></i> روابط سريعة</div>
            <div style="display:flex; gap:12px; flex-wrap:wrap">
                <a asp-action="Index" style="display:flex; align-items:center; gap:8px; padding:11px 20px; background:rgba(0,201,167,0.1); border:1px solid rgba(0,201,167,0.25); border-radius:10px; color:#00c9a7; text-decoration:none; font-size:0.88rem; font-weight:600; transition:all 0.2s"
                   onmouseover="this.style.background='rgba(0,201,167,0.2)'" onmouseout="this.style.background='rgba(0,201,167,0.1)'">
                    <i class="fa-solid fa-magnifying-glass-plus"></i> فحص الأدوية
                </a>
                <a asp-action="History" style="display:flex; align-items:center; gap:8px; padding:11px 20px; background:rgba(13,110,253,0.1); border:1px solid rgba(13,110,253,0.25); border-radius:10px; color:#60a5fa; text-decoration:none; font-size:0.88rem; font-weight:600; transition:all 0.2s"
                   onmouseover="this.style.background='rgba(13,110,253,0.2)'" onmouseout="this.style.background='rgba(13,110,253,0.1)'">
                    <i class="fa-solid fa-clock-rotate-left"></i> سجل البحث
                </a>
                <a asp-action="MyMedications" style="display:flex; align-items:center; gap:8px; padding:11px 20px; background:rgba(255,165,2,0.1); border:1px solid rgba(255,165,2,0.25); border-radius:10px; color:#fbbf24; text-decoration:none; font-size:0.88rem; font-weight:600; transition:all 0.2s"
                   onmouseover="this.style.background='rgba(255,165,2,0.2)'" onmouseout="this.style.background='rgba(255,165,2,0.1)'">
                    <i class="fa-solid fa-pills"></i> أدويتي
                </a>
                <a asp-action="PregnancyDrugs" style="display:flex; align-items:center; gap:8px; padding:11px 20px; background:rgba(255,107,157,0.1); border:1px solid rgba(255,107,157,0.25); border-radius:10px; color:#ff6b9d; text-decoration:none; font-size:0.88rem; font-weight:600; transition:all 0.2s"
                   onmouseover="this.style.background='rgba(255,107,157,0.2)'" onmouseout="this.style.background='rgba(255,107,157,0.1)'">
                    <i class="fa-solid fa-baby"></i> أدوية الحمل
                </a>
                <a asp-action="Logout" style="display:flex; align-items:center; gap:8px; padding:11px 20px; background:rgba(255,71,87,0.1); border:1px solid rgba(255,71,87,0.25); border-radius:10px; color:#ff6b7a; text-decoration:none; font-size:0.88rem; font-weight:600; transition:all 0.2s"
                   onmouseover="this.style.background='rgba(255,71,87,0.2)'" onmouseout="this.style.background='rgba(255,71,87,0.1)'">
                    <i class="fa-solid fa-right-from-bracket"></i> تسجيل الخروج
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('genderSel').addEventListener('change', function() {
        var mr = document.getElementById('marriedRow');
        var pr = document.getElementById('pregnantRow');
        if (this.value === 'female') {
            mr.classList.add('visible');
        } else {
            mr.classList.remove('visible');
            pr.classList.remove('visible');
            document.getElementById('marriedChk').checked = false;
            document.getElementById('pregnantChk').checked = false;
        }
    });
    document.getElementById('marriedChk').addEventListener('change', function() {
        document.getElementById('mrLabel').textContent = this.checked ? 'نعم' : 'لا';
        var pr = document.getElementById('pregnantRow');
        if (this.checked) { pr.classList.add('visible'); }
        else { pr.classList.remove('visible'); document.getElementById('pregnantChk').checked = false; }
    });
    document.getElementById('pregnantChk').addEventListener('change', function() {
        document.getElementById('pgLabel').textContent = this.checked ? 'نعم' : 'لا';
    });
</script>
}
