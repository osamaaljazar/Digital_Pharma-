@{ ViewData["Title"]="استعادة كلمة المرور"; Layout=null; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>استعادة كلمة المرور – Digital Pharma</title><style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:20px;background:#0f172a;color:#fff;font-family:Tahoma,Arial,sans-serif}.card{width:min(440px,100%);padding:34px;background:#182338;border:1px solid #334155;border-radius:20px;box-shadow:0 24px 60px #0006}h1{font-size:1.5rem;margin:0 0 10px}p{color:#b8c4d6;line-height:1.8}label{display:block;margin:22px 0 8px}input{width:100%;padding:13px 14px;border:1px solid #52637d;border-radius:10px;background:#243247;color:#fff;font:inherit;outline:none}input:focus{border-color:#2dd4bf;box-shadow:0 0 0 3px #2dd4bf2b}button{width:100%;margin-top:16px;padding:13px;border:0;border-radius:11px;background:linear-gradient(135deg,#00a98f,#1268d8);color:#fff;font:inherit;font-weight:700;cursor:pointer}a{display:block;text-align:center;margin-top:18px;color:#6ee7d2;text-decoration:none}
</style></head><body><main class="card"><h1>استعادة كلمة المرور</h1><p>اكتب البريد المرتبط بحسابك، وسنرسل إليه رابطاً مؤقتاً لتعيين كلمة مرور جديدة.</p>
<form asp-action="ForgotPassword" method="post"><label for="email">البريد الإلكتروني</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254"><button type="submit">إرسال رابط الاستعادة</button></form>
<a asp-action="Auth">العودة إلى تسجيل الدخول</a></main></body></html>
