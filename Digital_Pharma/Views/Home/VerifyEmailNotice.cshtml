@{ViewData["Title"]="تأكيد البريد";Layout=null;var email=(string?)ViewBag.Email??"";}
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>تأكيد البريد</title><link rel="stylesheet" href="~/css/patient-pages.css"/></head>
<body><main style="max-width:560px;margin:8vh auto;padding:28px"><section class="panel"><h1>تأكيد البريد الإلكتروني</h1><p>أرسلنا رابط تأكيد إلى بريد الحساب. افتح الرابط لإكمال التسجيل وتسجيل الدخول.</p>
@if(TempData["VerifyEmailMessage"]!=null){<p>@TempData["VerifyEmailMessage"]</p>}
<form asp-action="ResendEmailConfirmation" method="post"><label>البريد الإلكتروني<input type="email" name="email" value="@email" required maxlength="254"/></label><button type="submit">إرسال رابط جديد</button></form><p><a asp-action="Auth">العودة إلى تسجيل الدخول</a></p></section></main></body></html>
