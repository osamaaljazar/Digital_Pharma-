@model Digital_Pharma.Models.AccountActivityPage
@{ViewData["Title"]="سجل النشاط";}
<style>.activity-page{max-width:900px;margin:auto;padding:42px 18px 70px}.activity-filters{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0}.activity-filters a{padding:8px 13px;border-radius:999px;text-decoration:none;color:#b8c6d9;background:rgba(255,255,255,.05);border:1px solid var(--border-clr)}.activity-filters a.active{color:#fff;background:rgba(0,201,167,.16);border-color:rgba(0,201,167,.4)}.activity-list{display:grid;gap:11px}.activity-row{display:flex;gap:14px;padding:16px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid var(--border-clr)}.activity-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:11px;flex:none;background:color-mix(in srgb,var(--item-color) 16%,transparent);color:var(--item-color)}.activity-row h2{font-size:1rem;margin:0 0 5px}.activity-row p{margin:0;color:#b0bfd2;overflow-wrap:anywhere}.activity-time{font-size:.77rem;color:#718198;margin-top:7px}.activity-nav{display:flex;justify-content:space-between;margin-top:20px}.activity-nav a{color:#8ee8da;text-decoration:none}.activity-empty{text-align:center;padding:50px;color:#9bacbf;border:1px dashed var(--border-clr);border-radius:16px}</style>
<main class="activity-page"><header><h1 class="h3">سجل النشاط</h1><p class="text-white-50">التغييرات المهمة في حسابك مرتبة زمنياً.</p></header>
<nav class="activity-filters">@foreach(var f in new[]{("all","الكل"),("medication","الأدوية"),("dose","الجرعات"),("treatment","الطبيب"),("care","الربط"),("check","الفحوص")}){<a class="@(Model.Filter==f.Item1?"active":"")" asp-action="Activity" asp-route-filter="@f.Item1">@f.Item2</a>}</nav>
@if(Model.Items.Count==0){<div class="activity-empty">لا يوجد نشاط ضمن هذا التصنيف.</div>}else{<div class="activity-list">@foreach(var item in Model.Items){<article class="activity-row" style="--item-color:@item.Color"><div class="activity-icon"><i class="fa-solid @item.Icon"></i></div><div><h2>@item.Title</h2><p>@item.Detail</p><div class="activity-time">@item.At.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd HH:mm") · عمّان</div></div></article>}</div>}
@if(Model.Page>1||Model.HasNext){<nav class="activity-nav">@if(Model.Page>1){<a asp-action="Activity" asp-route-filter="@Model.Filter" asp-route-page="@(Model.Page-1)">الأحدث</a>}else{<span></span>}@if(Model.HasNext){<a asp-action="Activity" asp-route-filter="@Model.Filter" asp-route-page="@(Model.Page+1)">الأقدم</a>}</nav>}
</main>
