@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Pharma – تسجيل الدخول</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Tajawal', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%);
            display: flex; align-items: center; justify-content: center;
            padding: 20px;
            overflow-y: auto;
        }
        /* Static bg orbs — no animation for performance */
        .orb {
            position: fixed; border-radius: 50%; z-index: 0; pointer-events: none;
        }
        .orb-1 { width: 350px; height: 350px; background: radial-gradient(circle, rgba(0,201,167,0.12) 0%, transparent 70%); top: -80px; right: -80px; }
        .orb-2 { width: 280px; height: 280px; background: radial-gradient(circle, rgba(13,110,253,0.12) 0%, transparent 70%); bottom: -60px; left: -60px; }
        /* Main wrapper */
        .auth-wrapper {
            position: relative; z-index: 1;
            width: 100%; max-width: 960px;
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0,0,0,0.5);
            display: flex;
            min-height: 600px;
        }
        /* Left hero panel */
        .hero-panel {
            width: 45%; padding: 50px 40px;
            background: linear-gradient(160deg, rgba(0,201,167,0.25), rgba(13,110,253,0.2));
            display: flex; flex-direction: column; justify-content: center;
            position: relative; overflow: hidden;
        }
        .hero-panel::before {
            content: ''; position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='1' fill='rgba(255,255,255,0.08)'/%3E%3C/svg%3E");
        }
        .hero-panel .logo {
            display: flex; align-items: center; gap: 12px; margin-bottom: 50px;
        }
        .hero-panel .logo .ico {
            width: 50px; height: 50px;
            background: linear-gradient(135deg, #00c9a7, #0d6efd);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem; color: white;
            box-shadow: 0 8px 20px rgba(0,201,167,0.4);
        }
        .hero-panel .logo span { font-size: 1.4rem; font-weight: 800; color: white; }
        .hero-panel h2 { font-size: 2rem; font-weight: 800; color: white; line-height: 1.3; margin-bottom: 16px; }
        .hero-panel p  { color: rgba(255,255,255,0.65); font-size: 1rem; line-height: 1.7; margin-bottom: 30px; }
        .hero-panel .features { display: flex; flex-direction: column; gap: 14px; }
        .hero-panel .feature-item {
            display: flex; align-items: center; gap: 12px;
            color: rgba(255,255,255,0.8); font-size: 0.9rem;
        }
        .hero-panel .feature-item .feat-icon {
            width: 32px; height: 32px;
            background: rgba(0,201,167,0.2);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #00c9a7; font-size: 0.9rem;
            flex-shrink: 0;
        }
        /* Right form panel */
        .form-panel {
            flex: 1; padding: 40px;
            display: flex; flex-direction: column; justify-content: center;
            position: relative; overflow: hidden;
        }
        /* Tab switcher */
        .tab-bar {
            display: flex; gap: 4px;
            background: rgba(255,255,255,0.06);
            border-radius: 12px; padding: 4px;
            margin-bottom: 30px;
        }
        .tab-bar button {
            flex: 1; padding: 10px;
            background: transparent; border: none;
            color: rgba(255,255,255,0.55); font-family: 'Tajawal', sans-serif;
            font-size: 0.95rem; font-weight: 600;
            border-radius: 9px; cursor: pointer; transition: all 0.3s;
        }
        .tab-bar button.active {
            background: linear-gradient(135deg, #00c9a7, #0d6efd);
            color: white;
            box-shadow: 0 4px 15px rgba(0,201,167,0.3);
        }
        /* Forms */
        .form-section { display: none; animation: fadeIn 0.35s ease; }
        .form-section.active { display: block; }
        @@keyframes fadeIn { from { opacity:0; transform: translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .form-section h3 {
            font-size: 1.4rem; font-weight: 700; color: white; margin-bottom: 6px;
        }
        .form-section .subtitle { color: rgba(255,255,255,0.5); font-size: 0.9rem; margin-bottom: 24px; }
        .field-group { margin-bottom: 16px; }
        .field-group label {
            display: block; color: rgba(255,255,255,0.75);
            font-size: 0.85rem; font-weight: 500; margin-bottom: 7px;
        }
        .field-group .input-wrap { position: relative; }
        .field-group .input-wrap i {
            position: absolute; top: 50%; transform: translateY(-50%);
            right: 14px; color: rgba(255,255,255,0.35); font-size: 0.9rem;
        }
        .field-group input {
            width: 100%; padding: 12px 40px 12px 14px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 10px; color: white;
            font-family: 'Tajawal', sans-serif; font-size: 0.95rem;
            transition: all 0.25s; outline: none;
        }
        .field-group input::placeholder { color: rgba(255,255,255,0.3); }
        .field-group input:focus {
            border-color: #00c9a7;
            background: rgba(0,201,167,0.07);
            box-shadow: 0 0 0 3px rgba(0,201,167,0.15);
        }
        .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .btn-submit {
            width: 100%; padding: 14px;
            background: linear-gradient(135deg, #00c9a7, #0d6efd);
            border: none; border-radius: 12px;
            color: white; font-family: 'Tajawal', sans-serif;
            font-size: 1rem; font-weight: 700;
            cursor: pointer; margin-top: 10px;
            transition: all 0.3s;
            box-shadow: 0 6px 20px rgba(0,201,167,0.3);
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,201,167,0.4);
        }
        .btn-submit:active { transform: translateY(0); }
        /* Error alert */
        .auth-alert {
            padding: 12px 16px;
            border-radius: 10px; font-size: 0.9rem;
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 16px;
        }
        .auth-alert.error { background: rgba(255,71,87,0.15); color: #ff6b7a; border: 1px solid rgba(255,71,87,0.3); }
        .divider { text-align: center; color: rgba(255,255,255,0.3); font-size: 0.8rem; margin: 16px 0; }
        /* Responsive */
        @@media (max-width: 700px) {
            .auth-wrapper { flex-direction: column; }
            .hero-panel { width: 100%; padding: 30px; }
            .hero-panel .features { display: none; }
            .form-panel { padding: 30px 24px; }
        }
    </style>
</head>
<body>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="auth-wrapper">
        <!-- Hero -->
        <div class="hero-panel">
            <div class="logo">
                <div class="ico"><i class="fa-solid fa-pills"></i></div>
                <span>Digital Pharma</span>
            </div>
            <h2>نظام فحص التداخل الدوائي الذكي</h2>
            <p>استعن بالذكاء الاصطناعي للكشف عن التفاعلات الخطيرة بين أدويتك قبل تناولها</p>
            <div class="features">
                <div class="feature-item">
                    <div class="feat-icon"><i class="fa-solid fa-brain"></i></div>
                    <span>تحليل بالذكاء الاصطناعي مع مراعاة حالتك الصحية</span>
                </div>
                <div class="feature-item">
                    <div class="feat-icon"><i class="fa-solid fa-database"></i></div>
                    <span>بيانات مرجعية من قاعدة FDA الأمريكية</span>
                </div>
                <div class="feature-item">
                    <div class="feat-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                    <span>سجل كامل لجميع عمليات البحث السابقة</span>
                </div>
                <div class="feature-item">
                    <div class="feat-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <span>خصوصية تامة وحماية لبياناتك الطبية</span>
                </div>
            </div>
        </div>

        <!-- Forms -->
        <div class="form-panel">
            <div class="tab-bar">
                <button class="active" onclick="switchTab('login', this)">تسجيل الدخول</button>
                <button onclick="switchTab('signup', this)">إنشاء حساب</button>
            </div>

            @if (TempData["LoginError"] != null)
            {
                <div class="auth-alert error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["LoginError"]
                </div>
            }
            @if (TempData["SignupError"] != null)
            {
                <div class="auth-alert error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @TempData["SignupError"]
                </div>
            }

            <!-- LOGIN -->
            <div class="form-section active" id="tab-login">
                <h3>أهلاً بعودتك</h3>
                <p class="subtitle">سجّل دخولك للوصول إلى حسابك</p>
                <form asp-action="Login" method="post">
                    <div class="field-group">
                        <label>البريد الإلكتروني</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" name="email" placeholder="example@email.com" required />
                        </div>
                    </div>
                    <div class="field-group">
                        <label>كلمة المرور</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="password" placeholder="••••••••" required />
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-right-to-bracket"></i> دخول
                    </button>
                </form>
                <div class="divider">ليس لديك حساب؟ <a href="#" onclick="switchTab('signup', null)" style="color:#00c9a7">أنشئ حساباً</a></div>
            </div>

            <!-- SIGNUP -->
            <div class="form-section" id="tab-signup">
                <h3>إنشاء حساب جديد</h3>
                <p class="subtitle">انضم إلينا وابدأ في حماية صحتك</p>
                <form asp-action="SignUp" method="post">
                    <div class="field-row">
                        <div class="field-group">
                            <label>الاسم</label>
                            <div class="input-wrap">
                                <i class="fa-solid fa-user"></i>
                                <input type="text" name="userName" placeholder="الاسم الكامل" required />
                            </div>
                        </div>
                        <div class="field-group">
                            <label>رقم الجوال</label>
                            <div class="input-wrap">
                                <i class="fa-solid fa-phone"></i>
                                <input type="tel" name="phoneNumber" placeholder="05xxxxxxxx" />
                            </div>
                        </div>
                    </div>
                    <div class="field-group">
                        <label>البريد الإلكتروني</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input type="email" name="email" placeholder="example@email.com" required />
                        </div>
                    </div>
                    <div class="field-group">
                        <label>كلمة المرور</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock"></i>
                            <input type="password" name="password" placeholder="8 أحرف على الأقل" required minlength="6" />
                        </div>
                    </div>
                    <div class="field-group">
                        <label>تاريخ الميلاد</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-calendar"></i>
                            <input type="date" name="dateOfBirth" required />
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">
                        <i class="fa-solid fa-user-plus"></i> إنشاء الحساب
                    </button>
                </form>
                <div class="divider">لديك حساب بالفعل؟ <a href="#" onclick="switchTab('login', null)" style="color:#00c9a7">سجّل دخولك</a></div>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tab, btn) {
            document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.tab-bar button').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            if (btn) btn.classList.add('active');
            else {
                const idx = tab === 'login' ? 0 : 1;
                document.querySelectorAll('.tab-bar button')[idx].classList.add('active');
            }
        }
        // Auto-switch to signup tab if signup error
        @if (TempData["SignupError"] != null)
        {
            <text>switchTab('signup', null);</text>
        }
    </script>
</body>
</html>
