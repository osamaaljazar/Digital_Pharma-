@model MedicationDashboard
@{
    ViewData["Title"] = "أدويتي";
}

@section HeadStyles {
<style>
    .meds-page { padding: 44px 0 60px; }
    .page-header { text-align:center; margin-bottom:40px; }
    .page-header .ph-icon {
        width:68px; height:68px;
        background: linear-gradient(135deg,rgba(0,201,167,.2),rgba(13,110,253,.2));
        border:1.5px solid rgba(0,201,167,.3);
        border-radius:50%; margin:0 auto 16px;
        display:flex; align-items:center; justify-content:center;
        font-size:1.7rem; color:#00c9a7;
    }
    .page-header h2 { font-size:1.7rem; font-weight:800; color:white; margin-bottom:8px; }
    .page-header p { color:rgba(255,255,255,.5); font-size:.95rem; max-width:460px; margin:0 auto; }
    /* Add form */
    .add-card {
        background:rgba(255,255,255,.05);
        border:1px solid rgba(255,255,255,.1);
        border-radius:18px; padding:28px 32px; margin-bottom:28px;
    }
    .add-card .ac-title {
        font-size:.9rem; font-weight:700; color:white; margin-bottom:16px;
        display:flex; align-items:center; gap:8px;
    }
    .add-card .ac-title i { color:#00c9a7; }
    .add-row { display:grid; grid-template-columns:1fr 1fr auto; gap:12px; align-items:end; }
    .fi-group label {
        display:block; color:rgba(255,255,255,.65); font-size:.82rem;
        font-weight:600; margin-bottom:7px;
    }
    .fi-group input, .fi-group textarea {
        width:100%; padding:12px 14px;
        background:rgba(255,255,255,.07);
        border:1.5px solid rgba(255,255,255,.12);
        border-radius:10px; color:white;
        font-family:'Tajawal',sans-serif; font-size:.93rem;
        outline:none; transition:all .25s;
    }
    .fi-group input::placeholder, .fi-group textarea::placeholder { color:rgba(255,255,255,.3); }
    .fi-group input:focus, .fi-group textarea:focus {
        border-color:#00c9a7; background:rgba(0,201,167,.07);
        box-shadow:0 0 0 3px rgba(0,201,167,.12);
    }
    .btn-add {
        padding:12px 22px;
        background:linear-gradient(135deg,#00c9a7,#0d6efd);
        border:none; border-radius:10px; color:white;
        font-family:'Tajawal',sans-serif; font-size:.92rem; font-weight:700;
        cursor:pointer; transition:all .3s; white-space:nowrap;
        box-shadow:0 6px 18px rgba(0,201,167,.28);
        display:flex; align-items:center; gap:7px;
    }
    .btn-add:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(0,201,167,.38); }
    /* Stats row */
    .stats-strip {
        display:flex; gap:16px; margin-bottom:24px; flex-wrap:wrap;
    }
    .stat-chip {
        flex:1; min-width:120px;
        background:rgba(255,255,255,.04);
        border:1px solid rgba(255,255,255,.08);
        border-radius:12px; padding:16px 20px; text-align:center;
    }
    .stat-chip .sc-num { font-size:1.6rem; font-weight:800; color:white; }
    .stat-chip .sc-lbl { font-size:.78rem; color:rgba(255,255,255,.45); margin-top:2px; }
    /* Med list */
    .med-list { display:flex; flex-direction:column; gap:14px; }
    .med-item {
        background:rgba(255,255,255,.04);
        border:1px solid rgba(255,255,255,.08);
        border-radius:14px; padding:18px 22px;
        display:flex; align-items:center; gap:16px;
        transition:all .25s; animation:fadeInUp .35s ease;
    }
    .med-item:hover { background:rgba(255,255,255,.07); border-color:rgba(255,255,255,.14); }
    .med-icon {
        width:44px; height:44px; border-radius:11px;
        background:linear-gradient(135deg,rgba(0,201,167,.2),rgba(13,110,253,.2));
        border:1px solid rgba(0,201,167,.2);
        display:flex; align-items:center; justify-content:center;
        color:#00c9a7; font-size:1rem; flex-shrink:0;
    }
    .med-info { flex:1; }
    .med-info .med-name { font-size:1rem; font-weight:700; color:white; margin-bottom:3px; }
    .med-info .med-notes { font-size:.8rem; color:rgba(255,255,255,.45); }
    .med-info .med-date { font-size:.75rem; color:rgba(255,255,255,.3); margin-top:3px; }
    .med-actions { display:flex; gap:8px; }
    .btn-check-drug {
        padding:8px 14px;
        background:rgba(0,201,167,.12);
        border:1px solid rgba(0,201,167,.25);
        border-radius:8px; color:#00c9a7;
        font-family:'Tajawal',sans-serif; font-size:.8rem; font-weight:600;
        cursor:pointer; text-decoration:none;
        display:flex; align-items:center; gap:5px; transition:all .2s;
    }
    .btn-check-drug:hover { background:rgba(0,201,167,.2); color:#00c9a7; }
    .btn-del-med {
        padding:8px 12px;
        background:rgba(255,71,87,.1);
        border:1px solid rgba(255,71,87,.2);
        border-radius:8px; color:#ff4757;
        font-family:'Tajawal',sans-serif; font-size:.8rem;
        cursor:pointer; transition:all .2s; display:flex; align-items:center; gap:5px;
    }
    .btn-del-med:hover { background:rgba(255,71,87,.2); }
    /* Empty state */
    .empty-state {
        text-align:center; padding:60px 20px;
        color:rgba(255,255,255,.35);
    }
    .empty-state .es-icon { font-size:3.5rem; margin-bottom:16px; opacity:.4; }
    .empty-state p { font-size:.95rem; }
    /* Info note */
    .info-note {
        background:rgba(13,110,253,.08);
        border:1px solid rgba(13,110,253,.18);
        border-radius:12px; padding:14px 18px;
        display:flex; align-items:flex-start; gap:12px;
        margin-bottom:24px;
        color:rgba(255,255,255,.7); font-size:.87rem; line-height:1.7;
    }
    .info-note i { color:#60a5fa; margin-top:2px; flex-shrink:0; }
    @@keyframes fadeInUp {
        from { opacity:0; transform:translateY(14px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@media (max-width:600px) {
        .add-row { grid-template-columns:1fr; }
        .stats-strip { gap:10px; }
        .med-item { flex-direction:column; align-items:flex-start; }
        .med-actions { width:100%; }
    }
</style>
}
<link rel="stylesheet" href="~/css/patient-pages.css" asp-append-version="true" />

<div class="patient-page meds-page fade-up">

        <header class="patient-hero">
            <div class="patient-hero-icon"><i class="fa-solid fa-pills"></i></div>
            <div><h1>أدويتي</h1><p>تابع جرعاتك وخطتك الحالية، واحتفظ بتفاصيل كل دواء في مكان واضح.</p></div>
            <span class="hero-chip"><i class="fa-solid fa-shield-heart"></i> مراجعة صحية مساعدة</span>
        </header>

        <nav class="medications-tabs" aria-label="أقسام أدويتي">
            <a class="active" asp-controller="Home" asp-action="MyMedications" aria-current="page"><i class="fa-solid fa-list"></i> قائمة أدويتي</a>
            <a asp-controller="Doses" asp-action="Index"><i class="fa-regular fa-clock"></i> جرعات اليوم</a>
        </nav>

        @if (TempData["MedError"] != null)
        {
            <div style="background:rgba(255,71,87,.12);border:1px solid rgba(255,71,87,.3);color:#ff6b7a;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;gap:8px;align-items:center">
                <i class="fa-solid fa-triangle-exclamation"></i> @TempData["MedError"]
            </div>
        }
        @if (TempData["MedSuccess"] != null)
        {
            <div style="background:rgba(0,201,167,.12);border:1px solid rgba(0,201,167,.3);color:#00c9a7;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;gap:8px;align-items:center">
                <i class="fa-solid fa-circle-check"></i> @TempData["MedSuccess"]
            </div>
        }

        <!-- Info note -->
        <div class="info-note">
            <i class="fa-solid fa-circle-info"></i>
            <span>
                اربط الدواء بنشرته ومواده الفعالة لمراجعته وفق الحساسيات والحالات الصحية. التقييم جزئي، ولا يضمن غياب التنبيه سلامة الاستخدام.
            </span>
        </div>

        <!-- Add medication form -->
        <div class="add-card">
            <div class="ac-title"><i class="fa-solid fa-plus-circle"></i> إضافة دواء جديد</div>
            <a class="btn-add" asp-controller="Medications" asp-action="Search">إضافة دواء</a>
            <a class="btn-check-drug" asp-controller="Health" asp-action="Review">عرض مراجعة الأدوية الحالية</a>

        </div>

        <!-- Stats -->
        @if (Model.Medications.Count > 0)
        {
            <div class="summary-grid">
                <div class="summary-card"><i class="fa-solid fa-capsules"></i><div>
                    <strong>@Model.Medications.Count(m => !m.IsStopped)</strong><span>دواء مستمر</span>
                </div>
                </div>
                <div class="summary-card"><i class="fa-solid fa-chart-line"></i><div>
                    <strong>@(Model.RecordedAdherencePercent.HasValue?$"{Model.RecordedAdherencePercent:0}%":"—")</strong><span>الالتزام المسجل خلال 7 أيام</span>
                </div>
                </div>
                <div class="summary-card"><i class="fa-solid fa-triangle-exclamation"></i><div>
                    <strong>@(Model.LowStockCount + Model.ExpiryAlertCount)</strong><span>تنبيهات مخزون أو صلاحية</span>
                </div>
                </div>
            </div>
            <p class="field-help">نسبة الالتزام تحسب الجرعات التي سجلتها فقط: @Model.TakenLast7Days تم تناولها و@Model.SkippedLast7Days تم تخطيها. المواعيد غير المسجلة لا تُفترض تلقائياً.</p>
        }

        @if (ViewBag.HealthReview is HealthReview review) { <partial name="_HealthReview" model="review" /> }

        @if (Model.Medications.Count > 0)
        {
            <section class="med-organizer" aria-labelledby="med-organizer-title">
                <div class="organizer-heading"><div><h2 id="med-organizer-title">تنظيم القائمة</h2><p>ابحث أو رتّب أدويتك دون مغادرة الصفحة.</p></div><span id="med-visible-count" aria-live="polite">@Model.Medications.Count دواء</span></div>
                <div class="organizer-controls">
                    <div class="field organizer-search"><label for="med-search">البحث بالاسم</label><div class="search-input-wrap"><i class="fa-solid fa-magnifying-glass"></i><input id="med-search" type="search" placeholder="اكتب اسم الدواء" autocomplete="off" /></div></div>
                    <div class="field"><label for="med-filter">عرض</label><select id="med-filter"><option value="all">كل الأدوية</option><option value="active">المستمرة</option><option value="stopped">المتوقفة</option><option value="stock-alert">منخفضة أو نافدة</option><option value="expiry-alert">قريبة أو منتهية الصلاحية</option></select></div>
                    <div class="field"><label for="med-sort">الترتيب</label><select id="med-sort"><option value="newest">الأحدث إضافة</option><option value="name">الاسم</option><option value="stock">الأقل مخزوناً</option><option value="expiry">الأقرب صلاحية</option></select></div>
                    <button id="med-organizer-reset" class="organizer-reset" type="button"><i class="fa-solid fa-rotate-left"></i> مسح</button>
                </div>
            </section>
        }
        <!-- Medication list -->
        @if (Model.Medications.Count == 0)
        {
            <div class="empty-state">
                <div class="es-icon"><i class="fa-solid fa-prescription-bottle"></i></div>
                <p>لم تُضف أي أدوية بعد.<br>ابدأ بإضافة الأدوية التي تتناولها بانتظام.</p>
            </div>
        }
        else
        {
            <div class="med-list" id="med-list">
                @{var medicationIndex=0;}
                @foreach (var med in Model.Medications)
                {
                    var stockState=MedicationInsights.StockState(med);
                    var expiryState=MedicationInsights.ExpiryState(med);
                    var remainingDays=MedicationInsights.RemainingDays(med);
                    <article class="med-item medication-card" data-medication-card data-name="@med.DrugName.ToLowerInvariant()" data-state="@(med.IsStopped?"stopped":"active")" data-stock-state="@stockState" data-expiry-state="@expiryState" data-stock="@(med.Quantity?.ToString(System.Globalization.CultureInfo.InvariantCulture)??"999999999")" data-expiry="@(med.ExpiryDate?.ToString("yyyy-MM-dd")??"9999-12-31")" data-original-order="@medicationIndex">
                        <div class="med-icon"><i class="fa-solid fa-capsules"></i></div>
                        <div class="med-info">
                            <div class="med-name">@med.DrugName</div>
                            <span class="status-pill @(med.IsStopped?"stopped":"")"><i class="fa-solid @(med.IsStopped?"fa-box-archive":"fa-circle-check")"></i> @(med.IsStopped?"متوقف — الأرشيف":"مستمر")</span>
                            @if(!med.IsStopped && stockState=="empty"){<span class="med-alert danger"><i class="fa-solid fa-box-open"></i> نفد المخزون المسجل</span>}
                            else if(!med.IsStopped && stockState=="low"){<span class="med-alert warning"><i class="fa-solid fa-box"></i> المخزون منخفض@(remainingDays.HasValue?$" — نحو {remainingDays:0.#} يوم":"")</span>}
                            @if(!med.IsStopped && expiryState=="expired"){<span class="med-alert danger"><i class="fa-solid fa-calendar-xmark"></i> منتهي الصلاحية — لا تستخدمه قبل سؤال الصيدلي</span>}
                            else if(!med.IsStopped && expiryState=="soon"){<span class="med-alert warning"><i class="fa-regular fa-calendar"></i> تنتهي الصلاحية خلال 30 يوماً</span>}
                            <div class="med-overview">
                                <div class="med-fact"><small>الجرعة</small><strong>@(med.DoseAmount.HasValue?med.DoseAmount.Value.ToString("0.###")+" "+MedicationCardInput.UnitName(med.DoseUnit):"غير مسجلة")</strong></div>
                                <div class="med-fact"><small>المواعيد</small><strong>@(med.ScheduleKind=="daily"?med.DailyTimes:med.ScheduleKind=="as_needed"?"عند الحاجة":"غير محددة")</strong></div>
                                <div class="med-fact"><small>الكمية</small><strong>@(med.Quantity.HasValue?med.Quantity.Value.ToString("0.###")+" "+MedicationCardInput.UnitName(med.QuantityUnit):"غير مسجلة")</strong></div>
                            </div>
                            <details class="med-details"><summary>التفاصيل والمصدر</summary><div class="med-details-content">
                                <span>الصلاحية: @(med.ExpiryDate?.ToString("yyyy-MM-dd")??"غير مسجلة")</span>
                                @if(!string.IsNullOrWhiteSpace(med.Instructions)){<span>التعليمات: @med.Instructions</span>}
                                <span>@(med.LabelId==null ? "غير مرتبط بنشرة — التقييم غير مكتمل" : "مرتبط بنشرة؛ راجع المواد الفعالة والتنبيهات")</span>
                                @if (!string.IsNullOrEmpty(med.Notes)){<span><i class="fa-solid fa-note-sticky"></i> @med.Notes</span>}
                                <span><i class="fa-regular fa-calendar"></i> أُضيف: @med.CreatedAt.ToString("dd/MM/yyyy")</span>
                                @if(med.Quantity.HasValue && med.DoseAmount.HasValue && !MedicationInsights.CanDeduct(med)){<span>الخصم التلقائي متوقف لأن وحدة الجرعة لا تطابق وحدة المخزون.</span>}
                            </div></details>
                            <details class="med-details restock-box"><summary><i class="fa-solid fa-boxes-stacked"></i> إضافة عبوة أو كمية جديدة</summary>
                                <form asp-controller="Medications" asp-action="AddStock" method="post" class="restock-form">
                                    <input type="hidden" name="Id" value="@med.Id" /><input type="hidden" name="Version" value="@Convert.ToBase64String(med.RowVersion)" />
                                    <div class="field"><label for="amount-@med.Id">الكمية المضافة</label><input id="amount-@med.Id" name="Amount" type="number" min="0.001" max="999999.999" step="0.001" required /></div>
                                    <div class="field"><label for="unit-@med.Id">الوحدة</label><select id="unit-@med.Id" name="Unit" required><option value="">اختر</option>@foreach(var unit in MedicationCardInput.Units){if(med.QuantityUnit==unit.Key){<option value="@unit.Key" selected>@unit.Value</option>}else{<option value="@unit.Key">@unit.Value</option>}}</select></div>
                                    <input type="hidden" name="Reason" value="شراء عبوة جديدة" />
                                    <button class="secondary-action" type="submit"><i class="fa-solid fa-plus"></i> تحديث المخزون</button>
                                </form>
                            </details>
                            <div class="card-actions"><a class="secondary-action" asp-controller="Medications" asp-action="Edit" asp-route-id="@med.Id"><i class="fa-solid fa-pen"></i> تعديل البطاقة</a><a class="secondary-action" asp-controller="Medications" asp-action="Search" asp-route-medicationId="@med.Id" asp-route-q="@med.DrugName"><i class="fa-solid fa-link"></i> تحديث النشرة</a></div>
                        </div>
                        <div class="med-actions">
                            <a href="/Home/DrugInfo?name=@Uri.EscapeDataString(med.DrugName)" class="btn-check-drug">
                                <i class="fa-solid fa-book-medical"></i> معلومات
                            </a>
                            <form asp-action="DeleteMedication" method="post" style="margin:0"
                                  onsubmit="return confirm('هل تريد حذف هذا الدواء من قائمتك؟')">
                                <input type="hidden" name="id" value="@med.Id" />
                                <button type="submit" class="btn-del-med">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </article>
                    medicationIndex++;
                }
            </div>
            <div class="empty-clinical organizer-empty" id="med-organizer-empty" hidden><i class="fa-solid fa-filter-circle-xmark"></i><strong>لا توجد أدوية مطابقة</strong><p>جرّب كلمة أخرى أو امسح التصفية.</p></div>
        }

        <!-- Bottom links -->
        <div style="margin-top:32px; display:flex; gap:12px; flex-wrap:wrap">
            <a asp-action="Index" style="padding:12px 22px; background:rgba(0,201,167,.1); border:1px solid rgba(0,201,167,.25); border-radius:10px; color:#00c9a7; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; gap:7px">
                <i class="fa-solid fa-magnifying-glass-plus"></i> فحص تداخل الأدوية
            </a>
            <a asp-action="PregnancyDrugs" style="padding:12px 22px; background:rgba(255,107,157,.1); border:1px solid rgba(255,107,157,.25); border-radius:10px; color:#ff6b9d; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; gap:7px">
                <i class="fa-solid fa-baby"></i> أدوية الحمل الخطرة
            </a>
        </div>
</div>

@section Scripts {
<script>
(() => {
    const list = document.getElementById('med-list');
    if (!list) return;
    const cards = [...list.querySelectorAll('[data-medication-card]')];
    const search = document.getElementById('med-search');
    const filter = document.getElementById('med-filter');
    const sort = document.getElementById('med-sort');
    const reset = document.getElementById('med-organizer-reset');
    const count = document.getElementById('med-visible-count');
    const empty = document.getElementById('med-organizer-empty');
    const normalize = value => value.trim().toLocaleLowerCase('ar');
    const apply = () => {
        const term = normalize(search.value);
        const selectedFilter = filter.value;
        const visible = cards.filter(card => {
            const matchesName = !term || normalize(card.dataset.name).includes(term);
            const matchesFilter = selectedFilter === 'all' ||
                card.dataset.state === selectedFilter ||
                (selectedFilter === 'stock-alert' && ['low','empty'].includes(card.dataset.stockState)) ||
                (selectedFilter === 'expiry-alert' && ['soon','expired'].includes(card.dataset.expiryState));
            card.hidden = !(matchesName && matchesFilter);
            return !card.hidden;
        });
        const compare = {
            newest: (a,b) => Number(a.dataset.originalOrder) - Number(b.dataset.originalOrder),
            name: (a,b) => a.dataset.name.localeCompare(b.dataset.name, 'ar'),
            stock: (a,b) => Number(a.dataset.stock) - Number(b.dataset.stock),
            expiry: (a,b) => a.dataset.expiry.localeCompare(b.dataset.expiry)
        }[sort.value];
        [...cards].sort(compare).forEach(card => list.appendChild(card));
        count.textContent = `${visible.length} من ${cards.length}`;
        empty.hidden = visible.length !== 0;
    };
    [search, filter, sort].forEach(control => control.addEventListener('input', apply));
    reset.addEventListener('click', () => { search.value=''; filter.value='all'; sort.value='newest'; apply(); search.focus(); });
    apply();
})();
</script>
}
