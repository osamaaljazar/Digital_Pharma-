@model List<Digital_Pharma.Models.UserMedication>
@{
    ViewData["Title"] = "أدويتي";
}

@section HeadStyles {
<style>
    .meds-page { padding: 44px 0 60px; }
    .page-header { text-align:center; margin-bottom:40px; }
    .page-header .ph-icon {
        width:68px; height:68px;
        background: linear-gradient(135deg,rgba(0,201,167,.2),rgba(13,110,253,.2));
        border:1.5px solid rgba(0,201,167,.3);
        border-radius:50%; margin:0 auto 16px;
        display:flex; align-items:center; justify-content:center;
        font-size:1.7rem; color:#00c9a7;
    }
    .page-header h2 { font-size:1.7rem; font-weight:800; color:white; margin-bottom:8px; }
    .page-header p { color:rgba(255,255,255,.5); font-size:.95rem; max-width:460px; margin:0 auto; }
    /* Add form */
    .add-card {
        background:rgba(255,255,255,.05);
        border:1px solid rgba(255,255,255,.1);
        border-radius:18px; padding:28px 32px; margin-bottom:28px;
    }
    .add-card .ac-title {
        font-size:.9rem; font-weight:700; color:white; margin-bottom:16px;
        display:flex; align-items:center; gap:8px;
    }
    .add-card .ac-title i { color:#00c9a7; }
    .add-row { display:grid; grid-template-columns:1fr 1fr auto; gap:12px; align-items:end; }
    .fi-group label {
        display:block; color:rgba(255,255,255,.65); font-size:.82rem;
        font-weight:600; margin-bottom:7px;
    }
    .fi-group input, .fi-group textarea {
        width:100%; padding:12px 14px;
        background:rgba(255,255,255,.07);
        border:1.5px solid rgba(255,255,255,.12);
        border-radius:10px; color:white;
        font-family:'Tajawal',sans-serif; font-size:.93rem;
        outline:none; transition:all .25s;
    }
    .fi-group input::placeholder, .fi-group textarea::placeholder { color:rgba(255,255,255,.3); }
    .fi-group input:focus, .fi-group textarea:focus {
        border-color:#00c9a7; background:rgba(0,201,167,.07);
        box-shadow:0 0 0 3px rgba(0,201,167,.12);
    }
    .btn-add {
        padding:12px 22px;
        background:linear-gradient(135deg,#00c9a7,#0d6efd);
        border:none; border-radius:10px; color:white;
        font-family:'Tajawal',sans-serif; font-size:.92rem; font-weight:700;
        cursor:pointer; transition:all .3s; white-space:nowrap;
        box-shadow:0 6px 18px rgba(0,201,167,.28);
        display:flex; align-items:center; gap:7px;
    }
    .btn-add:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(0,201,167,.38); }
    /* Stats row */
    .stats-strip {
        display:flex; gap:16px; margin-bottom:24px; flex-wrap:wrap;
    }
    .stat-chip {
        flex:1; min-width:120px;
        background:rgba(255,255,255,.04);
        border:1px solid rgba(255,255,255,.08);
        border-radius:12px; padding:16px 20px; text-align:center;
    }
    .stat-chip .sc-num { font-size:1.6rem; font-weight:800; color:white; }
    .stat-chip .sc-lbl { font-size:.78rem; color:rgba(255,255,255,.45); margin-top:2px; }
    /* Med list */
    .med-list { display:flex; flex-direction:column; gap:14px; }
    .med-item {
        background:rgba(255,255,255,.04);
        border:1px solid rgba(255,255,255,.08);
        border-radius:14px; padding:18px 22px;
        display:flex; align-items:center; gap:16px;
        transition:all .25s; animation:fadeInUp .35s ease;
    }
    .med-item:hover { background:rgba(255,255,255,.07); border-color:rgba(255,255,255,.14); }
    .med-icon {
        width:44px; height:44px; border-radius:11px;
        background:linear-gradient(135deg,rgba(0,201,167,.2),rgba(13,110,253,.2));
        border:1px solid rgba(0,201,167,.2);
        display:flex; align-items:center; justify-content:center;
        color:#00c9a7; font-size:1rem; flex-shrink:0;
    }
    .med-info { flex:1; }
    .med-info .med-name { font-size:1rem; font-weight:700; color:white; margin-bottom:3px; }
    .med-info .med-notes { font-size:.8rem; color:rgba(255,255,255,.45); }
    .med-info .med-date { font-size:.75rem; color:rgba(255,255,255,.3); margin-top:3px; }
    .med-actions { display:flex; gap:8px; }
    .btn-check-drug {
        padding:8px 14px;
        background:rgba(0,201,167,.12);
        border:1px solid rgba(0,201,167,.25);
        border-radius:8px; color:#00c9a7;
        font-family:'Tajawal',sans-serif; font-size:.8rem; font-weight:600;
        cursor:pointer; text-decoration:none;
        display:flex; align-items:center; gap:5px; transition:all .2s;
    }
    .btn-check-drug:hover { background:rgba(0,201,167,.2); color:#00c9a7; }
    .btn-del-med {
        padding:8px 12px;
        background:rgba(255,71,87,.1);
        border:1px solid rgba(255,71,87,.2);
        border-radius:8px; color:#ff4757;
        font-family:'Tajawal',sans-serif; font-size:.8rem;
        cursor:pointer; transition:all .2s; display:flex; align-items:center; gap:5px;
    }
    .btn-del-med:hover { background:rgba(255,71,87,.2); }
    /* Empty state */
    .empty-state {
        text-align:center; padding:60px 20px;
        color:rgba(255,255,255,.35);
    }
    .empty-state .es-icon { font-size:3.5rem; margin-bottom:16px; opacity:.4; }
    .empty-state p { font-size:.95rem; }
    /* Info note */
    .info-note {
        background:rgba(13,110,253,.08);
        border:1px solid rgba(13,110,253,.18);
        border-radius:12px; padding:14px 18px;
        display:flex; align-items:flex-start; gap:12px;
        margin-bottom:24px;
        color:rgba(255,255,255,.7); font-size:.87rem; line-height:1.7;
    }
    .info-note i { color:#60a5fa; margin-top:2px; flex-shrink:0; }
    @@keyframes fadeInUp {
        from { opacity:0; transform:translateY(14px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@media (max-width:600px) {
        .add-row { grid-template-columns:1fr; }
        .stats-strip { gap:10px; }
        .med-item { flex-direction:column; align-items:flex-start; }
        .med-actions { width:100%; }
    }
</style>
}

<div class="meds-page fade-up">
    <div class="container" style="max-width:800px">

        <div class="page-header">
            <div class="ph-icon"><i class="fa-solid fa-pills"></i></div>
            <h2>أدويتي</h2>
            <p>سجّل الأدوية التي تتناولها بانتظام وسيُنبّهك النظام تلقائياً عند فحص أي دواء جديد يتعارض معها</p>
        </div>

        @if (TempData["MedError"] != null)
        {
            <div style="background:rgba(255,71,87,.12);border:1px solid rgba(255,71,87,.3);color:#ff6b7a;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;gap:8px;align-items:center">
                <i class="fa-solid fa-triangle-exclamation"></i> @TempData["MedError"]
            </div>
        }
        @if (TempData["MedSuccess"] != null)
        {
            <div style="background:rgba(0,201,167,.12);border:1px solid rgba(0,201,167,.3);color:#00c9a7;border-radius:10px;padding:12px 16px;margin-bottom:16px;display:flex;gap:8px;align-items:center">
                <i class="fa-solid fa-circle-check"></i> @TempData["MedSuccess"]
            </div>
        }

        <!-- Info note -->
        <div class="info-note">
            <i class="fa-solid fa-circle-info"></i>
            <span>
                عندما تفحص أي دواء جديد في صفحة الفحص، سيتحقق الذكاء الاصطناعي تلقائياً من تعارضه مع كل الأدوية المحفوظة هنا وسيُظهر تحذيراً فورياً إذا وُجد خطر.
            </span>
        </div>

        <!-- Add medication form -->
        <div class="add-card">
            <div class="ac-title"><i class="fa-solid fa-plus-circle"></i> إضافة دواء جديد</div>
            <form asp-action="AddMedication" method="post">
                <div class="add-row">
                    <div class="fi-group">
                        <label>اسم الدواء *</label>
                        <input type="text" name="drugName" placeholder="مثال: Metformin, Lisinopril..." required autocomplete="off" />
                    </div>
                    <div class="fi-group">
                        <label>ملاحظات (اختياري)</label>
                        <input type="text" name="notes" placeholder="مثال: 500mg يومياً" />
                    </div>
                    <button type="submit" class="btn-add">
                        <i class="fa-solid fa-plus"></i> إضافة
                    </button>
                </div>
            </form>
        </div>

        <!-- Stats -->
        @if (Model != null && Model.Count > 0)
        {
            <div class="stats-strip">
                <div class="stat-chip">
                    <div class="sc-num" style="color:#00c9a7">@Model.Count</div>
                    <div class="sc-lbl">دواء محفوظ</div>
                </div>
                <div class="stat-chip">
                    <div class="sc-num" style="color:#60a5fa">@Model.Count(m => m.Notes != null)</div>
                    <div class="sc-lbl">مع ملاحظات</div>
                </div>
                <div class="stat-chip">
                    <div class="sc-num" style="color:#fbbf24">@Model.Count(m => m.CreatedAt >= DateTime.Today.AddDays(-7))</div>
                    <div class="sc-lbl">مضافة هذا الأسبوع</div>
                </div>
            </div>
        }

        <!-- Medication list -->
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <div class="es-icon"><i class="fa-solid fa-prescription-bottle"></i></div>
                <p>لم تُضف أي أدوية بعد.<br>ابدأ بإضافة الأدوية التي تتناولها بانتظام.</p>
            </div>
        }
        else
        {
            <div class="med-list">
                @foreach (var med in Model)
                {
                    <div class="med-item">
                        <div class="med-icon"><i class="fa-solid fa-capsules"></i></div>
                        <div class="med-info">
                            <div class="med-name">@med.DrugName</div>
                            @if (!string.IsNullOrEmpty(med.Notes))
                            {
                                <div class="med-notes"><i class="fa-solid fa-note-sticky" style="margin-left:4px"></i>@med.Notes</div>
                            }
                            <div class="med-date"><i class="fa-regular fa-calendar" style="margin-left:4px"></i>أُضيف: @med.CreatedAt.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="med-actions">
                            <a href="/Home/DrugInfo?name=@Uri.EscapeDataString(med.DrugName)" class="btn-check-drug">
                                <i class="fa-solid fa-book-medical"></i> معلومات
                            </a>
                            <form asp-action="DeleteMedication" method="post" style="margin:0"
                                  onsubmit="return confirm('هل تريد حذف @med.DrugName من قائمتك؟')">
                                <input type="hidden" name="id" value="@med.Id" />
                                <button type="submit" class="btn-del-med">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Bottom links -->
        <div style="margin-top:32px; display:flex; gap:12px; flex-wrap:wrap">
            <a asp-action="Index" style="padding:12px 22px; background:rgba(0,201,167,.1); border:1px solid rgba(0,201,167,.25); border-radius:10px; color:#00c9a7; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; gap:7px">
                <i class="fa-solid fa-magnifying-glass-plus"></i> فحص تداخل الأدوية
            </a>
            <a asp-action="PregnancyDrugs" style="padding:12px 22px; background:rgba(255,107,157,.1); border:1px solid rgba(255,107,157,.25); border-radius:10px; color:#ff6b9d; text-decoration:none; font-size:.9rem; font-weight:600; display:flex; align-items:center; gap:7px">
                <i class="fa-solid fa-baby"></i> أدوية الحمل الخطرة
            </a>
        </div>
    </div>
</div>
