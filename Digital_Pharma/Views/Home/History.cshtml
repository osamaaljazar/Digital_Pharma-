@model InteractionHistoryPage
@{
    ViewData["Title"]="سجل الفحوص";
    string Color(string severity)=>severity switch {"safe"=>"#00c9a7","caution"=>"#3ecf8e","moderate"=>"#ffa502","serious"=>"#ff6348","critical"=>"#ff4757",_=>"#94a3b8"};
    string Label(string severity)=>severity switch {"safe"=>"لم تظهر إشارة ضمن الأدلة المكتملة","caution"=>"انتباه","moderate"=>"متوسط","serious"=>"خطير","critical"=>"خطر شديد",_=>"غير مكتمل"};
}
<link rel="stylesheet" href="~/css/patient-pages.css" asp-append-version="true" />
<style>
.checks-page{max-width:920px;margin:auto;padding:42px 20px 70px;color:#eef5ff}.checks-head{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:24px}.checks-head h1{margin:0;font-size:1.8rem}.checks-head p{margin:5px 0 0;color:#9fb0c5}.check-group{margin:14px 0;padding:19px;border:1px solid rgba(255,255,255,.09);border-right:4px solid var(--sev);border-radius:16px;background:rgba(20,36,57,.72)}.check-group-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.check-group h2{margin:0 0 5px;font-size:1.05rem}.check-meta{color:#8fa1b8;font-size:.8rem}.check-badge{padding:6px 10px;border-radius:999px;color:var(--sev);background:rgba(148,163,184,.1);font-size:.75rem;font-weight:800;white-space:nowrap}.evidence-line{margin:12px 0;padding:9px 11px;border-radius:10px;color:#b9c8da;background:rgba(148,163,184,.07);font-size:.81rem}.pairs{display:grid;gap:8px;margin-top:12px}.pair-row{padding:11px 12px;border-radius:10px;background:rgba(255,255,255,.035)}.pair-row strong{font-size:.9rem}.pair-row p{margin:5px 0 0;color:#9eafc3;font-size:.82rem;line-height:1.6}.history-nav{display:flex;justify-content:space-between;gap:10px;margin-top:22px}.history-nav a,.new-check{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 15px;border:1px solid rgba(0,201,167,.25);border-radius:10px;color:#8ee8da;background:rgba(0,201,167,.08);text-decoration:none;font-weight:700}.history-empty{text-align:center;padding:55px 20px;border:1px dashed rgba(255,255,255,.14);border-radius:17px;color:#9aabc0}@@media(max-width:600px){.checks-page{padding:28px 14px 50px}.checks-head,.check-group-head{align-items:stretch;flex-direction:column}.new-check{width:100%}.check-badge{width:max-content}}
</style>
<main class="checks-page">
 <header class="checks-head"><div><h1>سجل الفحوص</h1><p>كل فحص محفوظ مع وقته وحالة اكتمال مصادره.</p></div><a class="new-check" asp-action="Index"><i class="fa-solid fa-plus"></i> فحص جديد</a></header>
 @if(Model.Groups.Count==0){<div class="history-empty"><i class="fa-solid fa-clock-rotate-left"></i><h2>لا توجد فحوص محفوظة</h2><p>ستظهر نتائج فحص الدواءين والمجموعة هنا.</p></div>}
 @foreach(var group in Model.Groups){var color=Color(group.Severity);<article class="check-group" style="--sev:@color" data-history-group data-severity="@group.Severity" data-kind="@group.Kind" data-evidence-status="@group.EvidenceStatus">
   <div class="check-group-head"><div><h2>@(group.Kind=="multi"?$"فحص مجموعة · {group.DrugCount} أدوية":"فحص دواءين")</h2><div class="check-meta"><i class="fa-regular fa-clock"></i> @group.EvaluatedAt.ToOffset(TimeSpan.FromHours(3)).ToString("yyyy-MM-dd HH:mm") · عمّان</div></div><span class="check-badge">@Label(group.Severity)</span></div>
   <div class="evidence-line"><i class="fa-solid @(group.EvidenceStatus=="complete"?"fa-circle-check":"fa-circle-question")"></i> @(group.EvidenceStatus=="complete"?"مصادر الفحص مكتملة حسب البيانات المتاحة":group.EvidenceStatus=="legacy"?"سجل قديم؛ لم تكن حالة المصادر محفوظة":"مصادر الفحص غير مكتملة؛ لا تُفهم النتيجة كدليل أمان")</div>
   <div class="pairs">@foreach(var result in group.Results){<div class="pair-row"><strong>@result.Drug1Name <span aria-hidden="true">×</span> @result.Drug2Name</strong><p>@(string.IsNullOrWhiteSpace(result.ResultMessage)?result.EvidenceNote:result.ResultMessage)</p></div>}</div>
  </article>}
 @if(Model.Page>1 || Model.HasNext){<nav class="history-nav" aria-label="صفحات سجل الفحوص">@if(Model.Page>1){<a asp-action="History" asp-route-page="@(Model.Page-1)">الأحدث</a>}else{<span></span>}@if(Model.HasNext){<a asp-action="History" asp-route-page="@(Model.Page+1)">الأقدم</a>}</nav>}
</main>
