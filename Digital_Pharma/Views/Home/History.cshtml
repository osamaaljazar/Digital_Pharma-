@model IEnumerable<Digital_Pharma.Models.Search>
@{
    ViewData["Title"] = "سجل البحث";
    var searches = Model?.ToList() ?? new List<Digital_Pharma.Models.Search>();

    string SevColor(string? sev) => sev?.ToLower() switch {
        "safe"     => "#00c9a7",
        "caution"  => "#3ecf8e",
        "moderate" => "#ffa502",
        "serious"  => "#ff6348",
        "critical" => "#ff4757",
        _          => "#94a3b8"
    };
    string SevLabel(string? sev) => sev?.ToLower() switch {
        "safe"     => "آمن",
        "caution"  => "انتباه",
        "moderate" => "متوسط",
        "serious"  => "خطير",
        "critical" => "خطر شديد",
        _          => "غير محدد"
    };
    string SevIcon(string? sev) => sev?.ToLower() switch {
        "safe"     => "fa-circle-check",
        "caution"  => "fa-eye",
        "moderate" => "fa-triangle-exclamation",
        "serious"  => "fa-circle-exclamation",
        "critical" => "fa-skull-crossbones",
        _          => "fa-question-circle"
    };
}

@section HeadStyles {
<style>
    .history-page { padding: 50px 0 60px; }
    .history-header {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 32px;
        flex-wrap: wrap; gap: 16px;
    }
    .history-header h2 { font-size: 1.6rem; font-weight: 800; color: white; }
    .history-header .count-badge {
        background: rgba(255,255,255,0.07);
        border: 1px solid rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.6);
        padding: 6px 16px; border-radius: 20px; font-size: 0.85rem;
    }
    /* Stats mini */
    .stats-mini {
        display: flex; gap: 14px; margin-bottom: 28px; flex-wrap: wrap;
    }
    .stat-mini-card {
        flex: 1; min-width: 130px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px; padding: 16px 18px;
        display: flex; align-items: center; gap: 12px;
    }
    .stat-mini-card .smc-icon {
        width: 38px; height: 38px; border-radius: 9px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
    }
    .stat-mini-card .smc-num { font-size: 1.4rem; font-weight: 800; color: white; }
    .stat-mini-card .smc-lbl { font-size: 0.75rem; color: rgba(255,255,255,0.45); }
    /* Filter bar */
    .filter-bar {
        display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap;
    }
    .filter-btn {
        padding: 7px 16px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 20px; color: rgba(255,255,255,0.6);
        font-family: 'Tajawal', sans-serif; font-size: 0.83rem; font-weight: 600;
        cursor: pointer; transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
        background: rgba(0,201,167,0.15);
        border-color: rgba(0,201,167,0.4);
        color: #00c9a7;
    }
    /* Search list */
    .search-item {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; padding: 20px 22px;
        margin-bottom: 14px;
        display: flex; align-items: flex-start; gap: 16px;
        transition: all 0.25s;
        animation: fadeInUp 0.4s ease;
    }
    .search-item:hover {
        background: rgba(255,255,255,0.07);
        border-color: rgba(255,255,255,0.15);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .si-severity {
        width: 44px; height: 44px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0; margin-top: 2px;
    }
    .si-body { flex: 1; min-width: 0; }
    .si-drugs {
        display: flex; align-items: center; gap: 8px;
        margin-bottom: 6px;
    }
    .si-drugs .drug-name {
        font-weight: 700; color: white; font-size: 1rem;
    }
    .si-drugs .vs-small {
        font-size: 0.7rem; font-weight: 700;
        background: rgba(255,255,255,0.1);
        padding: 1px 6px; border-radius: 4px;
        color: rgba(255,255,255,0.5);
    }
    .si-meta {
        display: flex; align-items: center; gap: 12px;
        flex-wrap: wrap;
    }
    .si-badge {
        font-size: 0.78rem; font-weight: 700;
        padding: 2px 10px; border-radius: 12px;
        display: flex; align-items: center; gap: 4px;
    }
    .si-date {
        font-size: 0.78rem; color: rgba(255,255,255,0.35);
        display: flex; align-items: center; gap: 4px;
    }
    .si-summary {
        font-size: 0.85rem; color: rgba(255,255,255,0.55);
        margin-top: 6px; line-height: 1.6;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        max-width: 500px;
    }
    /* Empty state */
    .empty-state {
        text-align: center; padding: 80px 20px;
        color: rgba(255,255,255,0.4);
    }
    .empty-state .es-icon {
        font-size: 3.5rem; margin-bottom: 20px; opacity: 0.3;
    }
    .empty-state h3 { font-size: 1.2rem; margin-bottom: 10px; color: rgba(255,255,255,0.6); }
    .empty-state p  { font-size: 0.9rem; margin-bottom: 24px; }
    .btn-start-check {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 13px 28px;
        background: linear-gradient(135deg, #00c9a7, #0d6efd);
        border-radius: 12px; color: white;
        text-decoration: none; font-weight: 700; font-size: 0.95rem;
        transition: all 0.3s;
        box-shadow: 0 8px 20px rgba(0,201,167,0.3);
    }
    .btn-start-check:hover { transform: translateY(-2px); color: white; box-shadow: 0 12px 30px rgba(0,201,167,0.4); }
    @@keyframes fadeInUp {
        from { opacity:0; transform:translateY(12px); }
        to   { opacity:1; transform:translateY(0); }
    }
</style>
}

<div class="history-page fade-up">
    <div class="container" style="max-width:820px">
        <div class="history-header">
            <div>
                <h2><i class="fa-solid fa-clock-rotate-left" style="color:#00c9a7; margin-left:10px"></i>سجل البحث</h2>
            </div>
            @if (searches.Count > 0)
            {
                <span class="count-badge">
                    <i class="fa-solid fa-list-check"></i>
                    @searches.Count عملية بحث
                </span>
            }
        </div>

        @if (searches.Count > 0)
        {
            <!-- Stats -->
            var totalDanger = searches.Count(s => s.Severity == "serious" || s.Severity == "critical");
            var totalSafe   = searches.Count(s => s.Severity == "safe");
            <div class="stats-mini">
                <div class="stat-mini-card">
                    <div class="smc-icon" style="background:rgba(0,201,167,0.15); color:#00c9a7">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <div>
                        <div class="smc-num">@searches.Count</div>
                        <div class="smc-lbl">إجمالي عمليات البحث</div>
                    </div>
                </div>
                <div class="stat-mini-card">
                    <div class="smc-icon" style="background:rgba(0,201,167,0.15); color:#00c9a7">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <div class="smc-num">@totalSafe</div>
                        <div class="smc-lbl">أدوية آمنة</div>
                    </div>
                </div>
                <div class="stat-mini-card">
                    <div class="smc-icon" style="background:rgba(255,71,87,0.15); color:#ff4757">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <div class="smc-num">@totalDanger</div>
                        <div class="smc-lbl">تداخلات خطيرة</div>
                    </div>
                </div>
                <div class="stat-mini-card">
                    <div class="smc-icon" style="background:rgba(13,110,253,0.15); color:#0d6efd">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div>
                        <div class="smc-num">@searches.Select(s => s.SearchDate.Date).Distinct().Count()</div>
                        <div class="smc-lbl">أيام نشاط</div>
                    </div>
                </div>
            </div>

            <!-- Filter bar -->
            <div class="filter-bar">
                <button class="filter-btn active" onclick="filterItems('all', this)">الكل</button>
                <button class="filter-btn" onclick="filterItems('safe', this)">آمن</button>
                <button class="filter-btn" onclick="filterItems('moderate', this)">متوسط</button>
                <button class="filter-btn" onclick="filterItems('serious', this)">خطير</button>
                <button class="filter-btn" onclick="filterItems('critical', this)">خطر شديد</button>
            </div>

            <!-- List -->
            <div id="searchList">
                @foreach (var s in searches)
                {
                    var color = SevColor(s.Severity);
                    var label = SevLabel(s.Severity);
                    var icon  = SevIcon(s.Severity);
                    <div class="search-item" data-sev="@(s.Severity?.ToLower() ?? "unknown")">
                        <div class="si-severity" style="background:@(color)20; color:@color">
                            <i class="fa-solid @icon"></i>
                        </div>
                        <div class="si-body">
                            <div class="si-drugs">
                                <span class="drug-name">@s.Drug1Name</span>
                                <span class="vs-small">VS</span>
                                <span class="drug-name">@s.Drug2Name</span>
                            </div>
                            <div class="si-meta">
                                <span class="si-badge" style="background:@(color)20; color:@color">
                                    <i class="fa-solid @icon" style="font-size:0.65rem"></i>
                                    @label
                                </span>
                                <span class="si-date">
                                    <i class="fa-regular fa-clock"></i>
                                    @s.SearchDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(s.ResultMessage))
                            {
                                <div class="si-summary">@s.ResultMessage</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="es-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                <h3>لا يوجد سجل بحث حتى الآن</h3>
                <p>قم بفحص أول دوائين لك وستظهر النتيجة هنا</p>
                <a asp-action="Index" class="btn-start-check">
                    <i class="fa-solid fa-magnifying-glass-plus"></i>
                    ابدأ أول فحص
                </a>
            </div>
        }

        @if (searches.Count > 0)
        {
            <div style="text-align:center; margin-top:28px">
                <a asp-action="Index" class="btn-start-check">
                    <i class="fa-solid fa-plus"></i> فحص جديد
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterItems(sev, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.search-item').forEach(function(item) {
            if (sev === 'all' || item.dataset.sev === sev) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }
</script>
}
