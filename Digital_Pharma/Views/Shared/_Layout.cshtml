<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Digital Pharma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --primary: #0d6efd;
            --primary-dark: #0a58ca;
            --teal: #00c9a7;
            --teal-dark: #00a389;
            --danger-clr: #ff4757;
            --warning-clr: #ffa502;
            --bg-dark: #0f172a;
            --bg-card: rgba(255,255,255,0.06);
            --border-clr: rgba(255,255,255,0.1);
            --text-muted-clr: rgba(255,255,255,0.55);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            color: #f8fafc;
        }
        /* ── Navbar ── */
        .navbar-dp {
            background: rgba(15,23,42,0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border-clr);
            padding: 12px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        .navbar-dp .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: white;
            font-weight: 800;
            font-size: 1.3rem;
        }
        .navbar-dp .brand .icon-wrap {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--teal), var(--primary));
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
        }
        .navbar-dp .nav-links { display: flex; align-items: center; gap: 6px; }
        .navbar-dp .nav-links a {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.25s;
            display: flex; align-items: center; gap: 6px;
        }
        .navbar-dp .nav-links a:hover,
        .navbar-dp .nav-links a.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }
        .navbar-dp .nav-links a.btn-logout {
            background: rgba(255,71,87,0.15);
            color: var(--danger-clr);
        }
        .navbar-dp .nav-links a.btn-logout:hover {
            background: rgba(255,71,87,0.3);
        }
        .navbar-dp .user-badge {
            background: linear-gradient(135deg, var(--teal), var(--primary));
            color: white;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex; align-items: center; gap: 6px;
        }
        /* ── Main content ── */
        .main-content { min-height: calc(100vh - 140px); }
        /* ── Footer ── */
        footer {
            border-top: 1px solid var(--border-clr);
            padding: 20px 0;
            text-align: center;
            color: var(--text-muted-clr);
            font-size: 0.85rem;
        }
        footer a { color: var(--teal); text-decoration: none; }
        /* ── Global card style ── */
        .glass-card {
            background: var(--bg-card);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-clr);
            border-radius: 16px;
        }
        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #1e293b; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
        /* ── Animations ── */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeInUp 0.5s ease forwards; }
        /* ── Alerts ── */
        .alert-dp {
            border-radius: 10px;
            border: none;
            padding: 12px 18px;
            font-weight: 500;
            display: flex; align-items: center; gap: 10px;
        }
        .alert-dp.success { background: rgba(0,201,167,0.15); color: var(--teal); border: 1px solid rgba(0,201,167,0.3); }
        .alert-dp.danger  { background: rgba(255,71,87,0.15);  color: var(--danger-clr); border: 1px solid rgba(255,71,87,0.3); }
        .alert-dp.warning { background: rgba(255,165,2,0.15);  color: var(--warning-clr); border: 1px solid rgba(255,165,2,0.3); }
    </style>
    @await RenderSectionAsync("HeadStyles", required: false)
</head>
<body>
    @{
        var loggedIn = Context.Session.GetInt32("UserId") != null;
        var userName = Context.Session.GetString("UserName") ?? "";
    }

    @if (loggedIn)
    {
        <nav class="navbar-dp">
            <div class="container d-flex align-items-center justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="brand">
                    <div class="icon-wrap"><i class="fa-solid fa-pills"></i></div>
                    <span>Digital Pharma</span>
                </a>
                <div class="nav-links">
                    <a asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-magnifying-glass-plus"></i> فحص الأدوية
                    </a>
                    <a asp-controller="Home" asp-action="MyMedications">
                        <i class="fa-solid fa-pills"></i> أدويتي
                    </a>
                    <a asp-controller="Home" asp-action="DrugInfo" asp-route-name="">
                        <i class="fa-solid fa-book-medical"></i> معلومات دواء
                    </a>
                    <a asp-controller="Home" asp-action="History">
                        <i class="fa-solid fa-clock-rotate-left"></i> السجل
                    </a>
                    <a asp-controller="Home" asp-action="Account">
                        <i class="fa-solid fa-user-circle"></i> حسابي
                    </a>
                    <div class="user-badge">
                        <i class="fa-solid fa-circle-user"></i>
                        @userName
                    </div>
                    <a asp-controller="Home" asp-action="Logout" class="btn-logout">
                        <i class="fa-solid fa-right-from-bracket"></i> خروج
                    </a>
                </div>
            </div>
        </nav>
    }

    <div class="main-content">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert-dp success fade-up">
                    <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
                </div>
            </div>
        }
        @RenderBody()
    </div>

    <footer>
        <div class="container">
            <p>
                <i class="fa-solid fa-shield-heart" style="color:var(--teal)"></i>
                &copy; 2025 Digital Pharma &mdash; جميع الحقوق محفوظة &nbsp;|&nbsp;
                <a href="#">سياسة الخصوصية</a>
            </p>
            <p style="font-size:0.75rem; margin-top:4px; opacity:0.6">
                هذا التطبيق لأغراض إرشادية فقط ولا يُغني عن استشارة الطبيب أو الصيدلاني
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
