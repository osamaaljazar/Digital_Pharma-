@using Digital_Pharma.Models
@model VisitReportPage
@{ViewData["Title"]="معاينة التقرير";var local=TimeZoneInfo.ConvertTimeBySystemTimeZoneId(Model.GeneratedAt,"Jordan Standard Time");}
@functions{string Times(UserMedication m)=>m.ScheduleKind=="daily"&&!string.IsNullOrWhiteSpace(m.DailyTimes)?m.DailyTimes.Replace(",","، "):m.ScheduleKind=="as_needed"?"عند الحاجة":"غير محدد";}
<style>
.report-shell{max-width:980px;margin:32px auto;padding:0 16px}.report-paper{background:#fff;color:#172033;border-radius:18px;padding:42px;box-shadow:0 18px 50px rgba(0,0,0,.25)}.report-head{display:flex;justify-content:space-between;gap:20px;border-bottom:3px solid #0f766e;padding-bottom:20px;margin-bottom:24px}.report-section{margin:24px 0;break-inside:avoid}.report-section h2{font-size:1.05rem;color:#0f766e;border-bottom:1px solid #dce4ea;padding-bottom:8px}.report-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 24px}.report-list{margin:0;padding-right:20px}.report-table{width:100%;border-collapse:collapse}.report-table th,.report-table td{border:1px solid #dce4ea;padding:9px;text-align:right;vertical-align:top}.report-table th{background:#eef7f6}.report-note{background:#fff7df;border-right:4px solid #d99b19;padding:14px}.report-disclaimer{font-size:.82rem;color:#596579;border-top:1px solid #dce4ea;padding-top:14px;margin-top:28px}.report-actions{display:flex;gap:12px;margin:0 auto 18px;max-width:980px;padding:0 16px}.report-actions button,.report-actions a{min-height:44px}@@media(max-width:650px){.report-paper{padding:24px 18px}.report-head,.report-grid{display:block}.report-head>div+div{margin-top:12px}.report-table{font-size:.82rem}}@@media print{.navbar-dp,footer,.report-actions,.ai-assistant-launcher,.ai-assistant-panel{display:none!important}body{background:white!important}.main-content{min-height:auto}.report-shell{margin:0;max-width:none;padding:0}.report-paper{box-shadow:none;border-radius:0;padding:12mm}.report-section{break-inside:avoid}@@page{size:A4;margin:10mm}}
</style>
<div class="report-actions"><button type="button" class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print ms-2"></i>طباعة أو حفظ PDF</button><a asp-action="Index" class="btn btn-outline-light">تعديل الاختيارات</a></div>
<main class="report-shell"><article class="report-paper">
 <header class="report-head"><div><h1 class="h3 mb-1">تقرير زيارة الطبيب</h1><strong>Digital Pharma</strong></div><div><div><strong>تاريخ الإعداد:</strong> @local.ToString("dd/MM/yyyy - HH:mm")</div><div><strong>رقم التقرير:</strong> DP-@Model.Patient.Id-@Model.GeneratedAt.ToUnixTimeSeconds()</div></div></header>
 @if(Model.Options.IncludeProfile){<section class="report-section"><h2>البيانات الأساسية</h2><div class="report-grid"><div><strong>الاسم:</strong> @Model.Patient.UserName</div><div><strong>العمر:</strong> @Model.Patient.Age سنة</div><div><strong>الجنس:</strong> @(Model.Patient.Gender=="female"?"أنثى":Model.Patient.Gender=="male"?"ذكر":"غير محدد")</div><div><strong>الطبيب المتابع:</strong> @(Model.DoctorName??"لا يوجد ربط فعّال")</div></div></section>}
 @if(!string.IsNullOrWhiteSpace(Model.Options.VisitNote)){<section class="report-section report-note"><strong>موضوع يرغب المريض بمناقشته:</strong><div>@Model.Options.VisitNote</div></section>}
 @if(Model.Options.IncludeConditions){<section class="report-section"><h2>الحالات الصحية المسجلة</h2>@if(Model.Conditions.Count==0){<p>لا توجد حالات مسجلة.</p>}else{<ul class="report-list">@foreach(var x in Model.Conditions){<li>@x</li>}</ul>}</section>}
 @if(Model.Options.IncludeAllergies){<section class="report-section"><h2>الحساسيات المسجلة</h2>@if(Model.Allergies.Count==0){<p>لا توجد حساسيات مسجلة.</p>}else{<table class="report-table"><thead><tr><th>الحساسية</th><th>التفاعل</th><th>الشدة المبلغ عنها</th></tr></thead><tbody>@foreach(var x in Model.Allergies){<tr><td>@x.Name</td><td>@x.Reaction</td><td>@(x.ReportedSeverity=="severe"?"شديدة":x.ReportedSeverity=="mild"?"خفيفة":"غير محددة")</td></tr>}</tbody></table>}</section>}
 @if(Model.Options.IncludeMedications){<section class="report-section"><h2>الأدوية الحالية</h2>@if(Model.Medications.Count==0){<p>لا توجد أدوية حالية.</p>}else{<table class="report-table"><thead><tr><th>الدواء</th><th>الجرعة</th><th>المواعيد</th><th>التعليمات</th></tr></thead><tbody>@foreach(var x in Model.Medications){<tr><td>@x.DrugName</td><td>@(x.DoseAmount?.ToString("0.###")??"—") @x.DoseUnit</td><td>@Times(x)</td><td>@(x.Instructions??"—")</td></tr>}</tbody></table>}</section>}
 @if(Model.Options.IncludeDoseSummary){var total=Model.TakenLast30Days+Model.SkippedLast30Days;<section class="report-section"><h2>ملخص الجرعات المسجلة — آخر 30 يوماً</h2><div class="report-grid"><div><strong>تم تناولها:</strong> @Model.TakenLast30Days</div><div><strong>تم تخطيها:</strong> @Model.SkippedLast30Days</div><div><strong>نسبة الالتزام من المسجل:</strong> @(total==0?"لا توجد بيانات":$"{Math.Round(Model.TakenLast30Days*100m/total)}%")</div></div></section>}
 @if(Model.Options.IncludeRecentChecks){<section class="report-section"><h2>آخر فحوص التداخلات</h2>@if(Model.RecentChecks.Count==0){<p>لا توجد فحوص محفوظة.</p>}else{<table class="report-table"><thead><tr><th>الدواءان</th><th>الخطورة</th><th>التاريخ</th></tr></thead><tbody>@foreach(var x in Model.RecentChecks){<tr><td>@x.Drug1Name — @x.Drug2Name</td><td>@(x.Severity??"غير محددة")</td><td>@(x.EvaluatedAt??new DateTimeOffset(x.SearchDate))</td></tr>}</tbody></table>}</section>}
 <p class="report-disclaimer">هذا التقرير يلخص المعلومات التي أدخلها المستخدم ونتائج إرشادية محفوظة. لا يمثل وصفة أو تشخيصاً، ويجب أن يراجعه الطبيب أو الصيدلي قبل اتخاذ قرار علاجي.</p>
</article></main>
